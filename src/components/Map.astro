---
// pallets/click (2247b35) as Sprout v0.6.0 sees it: every file in src/click
// and tests/ (tests/typing left out), joined by `sprout deps` edges. The
// layout is precomputed; what a change reaches is worked out in the browser
// and matches `sprout impact` (core.py: 12 files, 43 tests).
import graph from '../data/graph.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { nodes, edges } = graph;
const indeg = nodes.map(() => 0);
for (const [, to] of edges) indeg[to]++;
const isTest = (f: string) => f.startsWith('tests/');
const name = (f: string) => f.split('/').pop()!.replace(/\.py$/, '');
const radius = (i: number) => (isTest(nodes[i].f) ? 3.5 : 5 + Math.sqrt(indeg[i]) * 1.6);
---

<section class="section map" id="map">
  <div class="wrap">
    <div class="section-head">
      <h2>This is click, mapped.</h2>
      <p class="lead">
        Every source file and test in <a href="https://github.com/pallets/click">pallets/click</a>, joined by its real imports.
        Point at a file to light up everything a change to it reaches. That is the answer <code>sprout impact</code> gives your
        agent in one call.
      </p>
    </div>
    <div class="panel map-panel" data-graph={JSON.stringify(graph)}>
      <svg viewBox="0 0 1000 560" role="group" aria-label="Dependency map of pallets/click">
        <g class="edges" aria-hidden="true">
          {edges.map(([a, b]) => (
            <line x1={nodes[a].x} y1={nodes[a].y} x2={nodes[b].x} y2={nodes[b].y} pathLength="1" data-a={a} data-b={b} />
          ))}
        </g>
        <g class="nodes">
          {nodes.map((n, i) => (
            <g
              class:list={['n', { test: isTest(n.f) }]}
              data-i={i}
              tabindex="0"
              role="button"
              aria-label={n.f}
              transform={`translate(${n.x} ${n.y})`}
            >
              <circle r={radius(i)} />
              <circle class="hit" r="14" />
              {!isTest(n.f) && <text x={radius(i) + 5} y="4">{name(n.f)}</text>}
            </g>
          ))}
        </g>
      </svg>
      <div class="readout" aria-live="polite">
        <p class="file"><span class="muted">Change</span> <code data-file>src/click/core.py</code></p>
        <p class="reach"><b data-files>12</b> files <b data-tests>43</b> tests</p>
        <p class="cmdline"><span class="sigil">$</span> sprout impact <span data-arg>src/click/core.py</span></p>
      </div>
      <div class="legend" aria-hidden="true">
        <span><i class="src"></i>source file</span>
        <span><i class="tst"></i>test</span>
      </div>
    </div>
    <p class="caption muted">
      Measured with Sprout v0.6.0 at click 2247b35. Size is how many files import it.{' '}
      <a href={`${base}/docs/guides/impact/`}>How impact works</a>
    </p>
  </div>
</section>

<script>
  import { inView } from 'motion';
  import { reducedMotion } from '../scripts/motion';

  const panel = document.querySelector<HTMLElement>('.map-panel');
  if (panel) {
    const { nodes, edges } = JSON.parse(panel.dataset.graph!) as { nodes: { f: string }[]; edges: [number, number][] };
    const users: number[][] = nodes.map(() => []);
    for (const [a, b] of edges) users[b].push(a);
    const els = [...panel.querySelectorAll<SVGGElement>('.n')];
    const lines = [...panel.querySelectorAll<SVGLineElement>('.edges line')];
    const out = (k: string) => panel.querySelector<HTMLElement>(`[data-${k}]`)!;

    // Everything that imports the file, directly or through other files.
    const select = (s: number) => {
      const lit = new Set([s]);
      const queue = [s];
      while (queue.length) for (const u of users[queue.pop()!]) if (!lit.has(u)) lit.add(u), queue.push(u);
      panel.classList.add('focused');
      els.forEach((el, i) => {
        el.classList.toggle('lit', lit.has(i));
        el.classList.toggle('sel', i === s);
      });
      lines.forEach((l) => l.classList.toggle('lit', lit.has(+l.dataset.a!) && lit.has(+l.dataset.b!)));
      const reached = [...lit].filter((i) => i !== s).map((i) => nodes[i].f);
      out('file').textContent = out('arg').textContent = nodes[s].f;
      out('files').textContent = String(reached.filter((f) => !f.startsWith('tests/')).length);
      out('tests').textContent = String(reached.filter((f) => /(^|\/)test_[^/]*\.py$/.test(f)).length);
    };

    const start = nodes.findIndex((n) => n.f === 'src/click/core.py');
    select(start);

    // Until someone points at it, the map shows a few files in turn.
    let touched = false;
    const take = (i: number) => {
      touched = true;
      select(i);
    };
    els.forEach((el, i) => {
      el.addEventListener('pointerenter', () => take(i));
      el.addEventListener('focus', () => take(i));
      el.addEventListener('click', () => take(i));
    });

    if (!reducedMotion()) {
      const tour = ['core', 'types', '_compat', 'parser', 'utils', 'termui'].map((n) => nodes.findIndex((x) => x.f === `src/click/${n}.py`));
      let step = 0;
      let timer = 0;
      inView(panel, () => {
        panel.classList.add('drawn');
        timer = window.setInterval(() => {
          if (touched) return clearInterval(timer);
          select(tour[++step % tour.length]);
        }, 2600);
        return () => clearInterval(timer);
      }, { amount: 0.35 });
    }
  }
</script>

<style>
  .lead a {
    color: var(--ink);
    text-underline-offset: 4px;
  }
  .map-panel {
    position: relative;
    padding: clamp(8px, 2vw, 24px);
    background:
      radial-gradient(60% 70% at 50% 45%, rgba(79, 207, 130, 0.07), transparent 70%),
      var(--term);
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  line {
    stroke: var(--sage);
    stroke-width: 1;
    stroke-opacity: 0.16;
    transition:
      stroke-opacity 0.35s,
      stroke 0.35s;
  }
  .focused line:not(.lit) {
    stroke-opacity: 0.06;
  }
  line.lit {
    stroke: var(--leaf);
    stroke-opacity: 0.55;
  }
  .n {
    cursor: pointer;
    outline: none;
  }
  .n circle:not(.hit) {
    fill: var(--sage);
    transition:
      fill 0.3s,
      opacity 0.3s,
      r 0.3s;
  }
  .n.test circle:not(.hit) {
    fill: var(--term);
    stroke: var(--sage);
    stroke-width: 1.4;
  }
  .hit {
    fill: transparent;
  }
  .focused .n:not(.lit) circle:not(.hit),
  .focused .n:not(.lit) text {
    opacity: 0.28;
  }
  .n.lit circle:not(.hit) {
    fill: var(--leaf);
  }
  .n.test.lit circle:not(.hit) {
    fill: var(--term);
    stroke: var(--leaf);
  }
  .n.sel circle:not(.hit) {
    fill: #fff;
    filter: drop-shadow(0 0 8px var(--leaf)) drop-shadow(0 0 18px rgba(79, 207, 130, 0.6));
  }
  .n:focus-visible circle:not(.hit) {
    stroke: #fff;
    stroke-width: 2;
  }
  text {
    font: 500 12px var(--mono);
    fill: var(--term-fg);
    paint-order: stroke;
    stroke: var(--term);
    stroke-width: 4px;
    stroke-linejoin: round;
    pointer-events: none;
    transition: opacity 0.3s;
  }
  .n.sel text {
    fill: #fff;
    font-weight: 600;
  }

  /* The edges draw themselves in, once, as the map scrolls into view. */
  :global(.moving) line {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  :global(.moving) .drawn line {
    stroke-dashoffset: 0;
    transition:
      stroke-dashoffset 1.6s var(--ease),
      stroke-opacity 0.35s,
      stroke 0.35s;
  }

  .readout {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 28px;
    margin: 4px clamp(8px, 1.5vw, 12px) 4px;
    padding-top: 16px;
    border-top: 1px solid var(--term-line);
    font-size: 12.5px;
    line-height: 1.4;
  }
  .readout p {
    margin: 0;
  }
  .readout code {
    padding: 0;
    border: 0;
    background: none;
    color: #fff;
  }
  .reach {
    color: var(--muted);
  }
  .reach b {
    font: 600 26px var(--mono);
    color: var(--term-add);
    margin-left: 10px;
  }
  .reach b:first-child {
    margin-left: 0;
  }
  .cmdline {
    color: var(--term-dim);
  }
  .sigil {
    color: var(--term-add);
  }
  .legend {
    position: absolute;
    right: clamp(16px, 2.4vw, 32px);
    top: clamp(14px, 2vw, 24px);
    display: flex;
    gap: 16px;
    font: 12px var(--sans);
    color: var(--term-dim);
  }
  .legend i {
    display: inline-block;
    width: 9px;
    height: 9px;
    margin-right: 6px;
    border-radius: 50%;
    vertical-align: -1px;
  }
  .legend .src {
    background: var(--sage);
  }
  .legend .tst {
    border: 1.4px solid var(--sage);
  }
  .caption {
    margin: 16px 0 0;
    font-size: 13.5px;
  }
  .caption a {
    color: var(--ink-2);
    text-underline-offset: 4px;
  }
  @media (max-width: 760px) {
    text {
      font-size: 17px;
    }
    .n:not(.sel) text {
      display: none;
    }
  }
</style>
