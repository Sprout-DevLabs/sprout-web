---
import demo from '../data/demo.json';
const stops = demo.ai.map((s) => s.budget);
const start = 2;
---

<section class="section" id="ai">
  <div class="wrap split">
    <div class="copy">
      <h2>Context that fits the window</h2>
      <p class="lead">
        <code>sprout --ai</code> writes a plain-text map for a prompt or an agent. It covers what the project is, its stack,
        entry points, CI and config, uncommitted work, recent hotspots and the layout. Then come the{' '}
        <strong>key files</strong>: the code everything else uses most, with real function and type signatures.
      </p>
      <p class="muted">
        It never includes file contents. You set a token budget; folders open breadth-first while the map still fits, and
        your own code opens before tests and fixtures.
      </p>

      <div class="budget">
        <div class="budget-head">
          <label for="budget">Token budget</label>
          <output id="budget-out" for="budget">{stops[start]}</output>
        </div>
        <input type="range" id="budget" min="0" max={stops.length - 1} step="1" value={start} list="budget-ticks" />
        <datalist id="budget-ticks">{stops.map((_, i) => <option value={i} />)}</datalist>
        <div class="ends muted"><span>{stops[0]}</span><span>{stops.at(-1)}, everything fits</span></div>
      </div>
      <p class="hint muted">Drag the slider. Lines that change light up.</p>
    </div>

    <div class="panel map-panel">
      <div class="panel-bar">
        <span class="mono">sprout --ai --budget <b id="ai-budget">{stops[start]}</b></span>
        <span class="tok" id="ai-tokens"></span>
      </div>
      <div class="panel-body map-body">
        <div class="stage" id="ai-stage"></div>
      </div>
    </div>
  </div>
</section>

<script>
  import demo from '../data/demo.json';
  import { Stage } from '../scripts/stage';
  import { esc } from '../scripts/tree';

  const stops = demo.ai as { budget: number; tokens: number; text: string }[];
  const slider = document.getElementById('budget') as HTMLInputElement;
  const out = document.getElementById('budget-out')!;
  const cmd = document.getElementById('ai-budget')!;
  const tok = document.getElementById('ai-tokens')!;
  const stage = new Stage(document.getElementById('ai-stage')!);

  function color(line: string) {
    const h = esc(line);
    if (line.startsWith('#')) return `<span class="t-head">${h}</span>`;
    if (line.startsWith('(truncated')) return `<span class="t-st-M">${h}</span>`;
    return h
      .replace(/^([a-z][a-z ()0-9d,]*?:)/, '<span class="t-key">$1</span>')
      .replace(/^(\S[^(]*?) (\(used by \d+\))/, '<span class="t-dir">$1</span> <span class="t-dim">$2</span>')
      .replace(/(\(\d+ files?[^)]*\))/, '<span class="t-dim">$1</span>');
  }

  function show(i: number) {
    const s = stops[i];
    out.textContent = String(s.budget);
    cmd.textContent = String(s.budget);
    tok.textContent = `≈ ${s.tokens.toLocaleString()} tokens`;
    slider.style.setProperty('--p', `${(i / (stops.length - 1)) * 100}%`);
    let structure = false;
    const lines = s.text.replace(/\n$/, '').split('\n').map((line, n) => {
      if (line.startsWith('## ')) structure = true;
      // Section headings share their first word ("##"), so they key on the whole line.
      let key = line.startsWith('#') ? line : structure ? (line.match(/^\s*\S+/)?.[0] ?? `blank${n}`) : `h${n}:${line}`;
      if (line.startsWith('(truncated')) key = 'note';
      return { key, html: color(line) || ' ' };
    });
    stage.render(lines, { stagger: 0.012, maxStagger: 0.3 });
  }

  slider.addEventListener('input', () => show(+slider.value));
  show(+slider.value);
</script>

<style>
  .copy {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 22px;
    position: sticky;
    top: 110px;
  }
  .copy p {
    margin: 0;
  }
  .budget {
    margin-top: 12px;
    padding: 22px 22px 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .budget-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-weight: 500;
  }
  .budget output {
    font: 600 28px var(--mono);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  input[type='range'] {
    --p: 22%;
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 28px;
    margin: 14px 0 8px;
    background: transparent;
    cursor: pointer;
  }
  input[type='range']::-webkit-slider-runnable-track {
    height: 6px;
    border-radius: 6px;
    background: linear-gradient(to right, var(--leaf) var(--p), var(--line-2) var(--p));
  }
  input[type='range']::-moz-range-track {
    height: 6px;
    border-radius: 6px;
    background: linear-gradient(to right, var(--leaf) var(--p), var(--line-2) var(--p));
  }
  input[type='range']::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 22px;
    height: 22px;
    margin-top: -8px;
    border-radius: 50%;
    background: var(--surface);
    border: 2px solid var(--leaf);
    box-shadow: 0 2px 8px rgba(12, 26, 19, 0.2);
    transition: transform 0.2s var(--ease);
  }
  input[type='range']::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--surface);
    border: 2px solid var(--leaf);
  }
  input[type='range']:active::-webkit-slider-thumb {
    transform: scale(1.15);
  }
  .ends {
    display: flex;
    justify-content: space-between;
    font: 12.5px var(--mono);
  }
  .hint {
    font-size: 14px;
  }
  .map-panel .mono {
    font-family: var(--mono);
    color: var(--term-fg);
  }
  .map-panel .mono b {
    color: var(--term-add);
    font-weight: 500;
  }
  .tok {
    margin-left: auto;
    font-variant-numeric: tabular-nums;
  }
  .map-body {
    max-height: min(640px, 72vh);
    overflow: auto;
    -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 40px), transparent);
    mask-image: linear-gradient(to bottom, #000 calc(100% - 40px), transparent);
    padding-bottom: 40px;
  }
  .map-panel :global(.stage) {
    --row: 21px;
    font-size: 12.5px;
  }
  @media (max-width: 960px) {
    .copy {
      position: static;
    }
  }
</style>
