---
// Real output on pallets/click (2247b35) from Sprout v0.4.2. tour.txt is
// refreshed by the scheduled rebuild; impact and context are fixed samples.
import Term from './Term.astro';
import tour from '../data/tour.txt?raw';
import impact from '../data/impact.txt?raw';
import context from '../data/context.txt?raw';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tourShort = tour
  .split('\n')
  .filter((l) => /^(Tour of|\d+ directories|Languages|Start here)/.test(l) || /^\s+[1-5]\. /.test(l))
  .join('\n')
  .replace(/ \(\d+ entries[^)]*\)/, '');

const cards = [
  { q: 'Where do I start?', what: 'Layout, languages and what to read first.', cmd: 'sprout tour', out: tourShort, href: 'tour' },
  { q: 'What will this break?', what: 'Every file a change reaches, and the tests to run.', cmd: 'sprout impact FILE', out: impact, max: 9, href: 'impact' },
  { q: 'What do I need to know?', what: 'Signatures, users and tests for one file.', cmd: 'sprout context FILE', out: context, max: 10, href: 'context' },
];
---

<section class="section" id="questions">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">01 / Questions</p>
      <h2>Three questions. <span class="dim">One call each.</span></h2>
    </div>
    <div class="cards" data-cascade>
      {
        cards.map((c) => (
          <a class="card" data-spot href={`${base}/docs/guides/${c.href}/`}>
            <div class="panel"><Term text={c.out} max={c.max} /></div>
            <div class="words">
              <h3>{c.q}</h3>
              <p class="muted">{c.what}</p>
              <span class="foot"><code>{c.cmd}</code><span class="arrow-link">Guide</span></span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .card {
    display: flex;
    flex-direction: column;
    padding: 8px;
    border-radius: 22px;
    border: 1px solid var(--line);
    text-decoration: none;
    transition: border-color 0.25s;
  }
  .card:hover {
    border-color: var(--line-2);
  }
  .card .panel {
    height: 210px;
    padding: 18px;
    border-radius: 15px;
    box-shadow: none;
    -webkit-mask-image: linear-gradient(#000 70%, transparent);
    mask-image: linear-gradient(#000 70%, transparent);
  }
  .card :global(.term) {
    font-size: 11px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .words {
    display: grid;
    gap: 6px;
    padding: 14px 14px 12px;
  }
  .words p {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
  }
  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 14px;
  }
  .foot code {
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted);
    font-size: 12.5px;
  }
  @media (max-width: 960px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
