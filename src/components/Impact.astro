---
// The impact explorer: a real project's dependency graph. Pick a file and
// the change travels through everything that depends on it, hop by hop,
// to the tests that reach it. Graph and panel text are real Sprout output
// (src/data/impact-demo.json; scripts/impact-demo.md says how it was made).
import demo from '../data/impact-demo.json';

const W = 1000;
const H = 600;
const start = 'app/core/config.py';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Each edge runs from a file to what it depends on; dependencies sit to the left.
const curve = (a: (typeof demo.nodes)[number], b: (typeof demo.nodes)[number]) => {
  const mx = (a.x + b.x) / 2;
  return `M${b.x},${b.y} C${mx},${b.y} ${mx},${a.y} ${a.x},${a.y}`;
};
const files = demo.nodes.filter((n) => n.kind !== 'test').map((n) => n.path).sort();
const short = demo.commit.slice(0, 7);
---

<section class="section" id="impact">
  <div class="wrap">
    <div class="section-head">
      <h2>Change a file. See what it reaches.</h2>
      <p class="lead">
        <code>sprout impact</code> follows a change through every file that depends on it, directly or through others,
        and finds the tests that cover it. Pick a file in this real FastAPI backend.
      </p>
    </div>

    <div class="panel explorer" data-start={start}>
      <div class="panel-bar">
        <span class="cmdline">sprout impact <span class="target">{start}</span></span>
        <span class="touring" aria-hidden="true"><span class="pulse"></span>Touring · pick a file</span>
        <label class="pick">
          <span class="sr-only">File to change</span>
          <select aria-label="File to change">
            {files.map((f) => <option value={f} selected={f === start}>{f}</option>)}
          </select>
        </label>
      </div>

      <div class="stage">
        <svg viewBox={`0 0 ${W} ${H}`} role="group" aria-label="Dependency graph of the FastAPI backend">
          <g class="edges">
            {demo.edges.map(([from, to]) => <path d={curve(demo.nodes[from], demo.nodes[to])} data-from={from} data-to={to} pathLength="1" />)}
          </g>
          <g class="lit" aria-hidden="true">
            {demo.edges.map(([from, to]) => <path d={curve(demo.nodes[from], demo.nodes[to])} data-from={from} data-to={to} pathLength="1" />)}
          </g>
          <g class="nodes">
            {
              demo.nodes.map((n, i) => (
                <g
                  class:list={['node', n.kind]}
                  data-i={i}
                  data-path={n.path}
                  transform={`translate(${n.x} ${n.y})`}
                  tabindex={n.kind === 'test' ? undefined : 0}
                  role={n.kind === 'test' ? undefined : 'button'}
                  aria-label={n.kind === 'test' ? undefined : `Change ${n.path}`}
                >
                  <title>{n.path}</title>
                  <circle class="ring" r="7" />
                  <circle class="dot" r={n.kind === 'code' ? 5.5 : 4.5} />
                  {n.above ? <text x="0" y="-11" text-anchor="middle">{n.label}</text> : <text x="11" y="4">{n.label}</text>}
                </g>
              ))
            }
          </g>
        </svg>

        <div class="readout">
          <dl class="counts">
            <div><dt>files affected</dt><dd class="n-affected">0</dd></div>
            <div><dt>tests to run</dt><dd class="n-tests">0</dd></div>
          </dl>
          <pre class="out" tabindex="0" aria-live="polite"></pre>
        </div>
      </div>
    </div>

    <p class="note muted">
      Real output of <code>sprout impact</code> on <a href={`https://github.com/${demo.repo}/tree/${demo.commit}/${demo.folder}`}>{demo.repo}</a>{' '}
      ({demo.folder}/, {short}), Sprout {demo.sprout}: {demo.nodes.length} files and {demo.edges.length} imports. What files build on is on the
      left; tests are on the right, with test helpers dashed.
      <a class="more" href={`${base}/docs/guides/impact/`}>How impact works</a>
    </p>
  </div>
  <script type="application/json" id="impact-data" set:html={JSON.stringify({ edges: demo.edges, impact: demo.impact, nodes: demo.nodes.map((n) => ({ path: n.path })) })} />
</section>

<script>
  import { animate, inView } from 'motion';
  import { reducedMotion } from '../scripts/stage';

  type Data = { edges: [number, number][]; impact: Record<string, { text: string; affected: number; tests: number }>; nodes: { path: string }[] };
  const root = document.querySelector<HTMLElement>('#impact .explorer')!;
  const data: Data = JSON.parse(document.getElementById('impact-data')!.textContent!);
  const nodes = [...root.querySelectorAll<SVGGElement>('.node')];
  const lit = [...root.querySelectorAll<SVGPathElement>('.lit path')];
  const select = root.querySelector('select')!;
  const target = root.querySelector('.target')!;
  const out = root.querySelector<HTMLElement>('.out')!;
  const nAffected = root.querySelector<HTMLElement>('.n-affected')!;
  const nTests = root.querySelector<HTMLElement>('.n-tests')!;
  const index = new Map(data.nodes.map((n, i) => [n.path, i]));
  const users: number[][] = data.nodes.map(() => []); // who depends on each file
  for (const [from, to] of data.edges) users[to].push(from);

  const HOP = 0.32; // seconds per hop
  const ease = [0.22, 1, 0.36, 1] as const;
  let run = 0;

  // Breadth-first over dependents: each file at its shortest distance, and
  // the edge it was first reached through.
  function reach(start: number) {
    const depth = new Map([[start, 0]]);
    const via: [number, number][] = [];
    let frontier = [start];
    for (let d = 1; frontier.length; d++) {
      const next: number[] = [];
      for (const p of frontier)
        for (const u of users[p])
          if (!depth.has(u)) {
            depth.set(u, d);
            via.push([u, p]);
            next.push(u);
          }
      frontier = next;
    }
    return { depth, via };
  }

  function count(el: HTMLElement, to: number, duration: number, still: boolean) {
    if (still) return void (el.textContent = String(to));
    animate(0, to, { duration, ease, onUpdate: (v) => (el.textContent = String(Math.round(v))) });
  }

  function choose(path: string) {
    const i = index.get(path);
    if (i === undefined) return;
    const id = ++run;
    const still = reducedMotion();
    const { depth, via } = reach(i);
    const result = data.impact[path];
    const hops = Math.max(0, ...depth.values());
    select.value = path;
    target.textContent = path;
    root.classList.add('active');

    nodes.forEach((n, k) => {
      n.classList.remove('changed', 'reached');
      n.style.removeProperty('--d');
      const d = depth.get(k);
      if (d === 0) n.classList.add('changed');
      else if (d !== undefined) {
        n.style.setProperty('--d', `${still ? 0 : d * HOP}s`);
        n.classList.add('reached');
      }
    });

    // The edges the change travelled along draw in, one hop at a time.
    const travelled = new Set(via.map(([u, p]) => `${u}:${p}`));
    lit.forEach((p) => {
      const on = travelled.has(`${p.dataset.from}:${p.dataset.to}`);
      p.classList.toggle('on', on);
      if (!on) return animate(p, { strokeDashoffset: 1, opacity: 0 }, { duration: still ? 0 : 0.2 });
      const d = depth.get(Number(p.dataset.from))!;
      animate(p, { opacity: 1 }, { duration: 0 });
      animate(p, { strokeDashoffset: [1, 0] }, { duration: still ? 0 : HOP * 0.95, delay: still ? 0 : (d - 1) * HOP, ease: 'linear' });
    });

    if (!still) {
      const ring = root.querySelector<SVGCircleElement>(`.node[data-i="${i}"] .ring`)!;
      animate(ring, { scale: [1, 3.2], opacity: [0.8, 0] }, { duration: 0.9, ease });
    }
    count(nAffected, result.affected, still ? 0 : Math.max(0.4, hops * HOP), still);
    count(nTests, result.tests, still ? 0 : Math.max(0.4, hops * HOP), still);
    if (still) out.textContent = result.text;
    else
      animate(out, { opacity: [1, 0.15] }, { duration: 0.12 }).then(() => {
        if (id !== run) return;
        out.textContent = result.text;
        animate(out, { opacity: [0.15, 1] }, { duration: 0.35, ease });
      });
  }

  // While it's on screen and untouched, the explorer tours a few files with
  // different reaches. The first thing you do ends the tour for good.
  const tour = ['app/core/config.py', 'app/models.py', 'app/core/security.py', 'app/crud.py', 'app/api/deps.py'].filter((p) => index.has(p));
  let touring = !reducedMotion();
  let timer = 0;
  const badge = root.querySelector<HTMLElement>('.touring')!;
  const stopTour = () => {
    if (!touring) return;
    touring = false;
    clearInterval(timer);
    animate(badge, { opacity: 0, scale: 0.8 }, { duration: 0.3 }).then(() => badge.remove());
  };
  const pick = (path: string) => {
    stopTour();
    choose(path);
  };

  nodes.forEach((n) => {
    if (n.classList.contains('test')) return;
    n.addEventListener('click', () => pick(n.dataset.path!));
    n.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        pick(n.dataset.path!);
      }
    });
  });
  select.addEventListener('change', () => pick(select.value));
  select.addEventListener('pointerdown', stopTour);
  out.addEventListener('pointerdown', stopTour);

  out.textContent = data.impact[root.dataset.start!].text;
  if (!touring) badge.remove();
  inView(
    root,
    () => {
      if (!touring) return;
      let k = 0;
      choose(tour[k]);
      timer = window.setInterval(() => touring && choose(tour[(k = (k + 1) % tour.length)]), 4600);
      return () => clearInterval(timer); // paused while off screen
    },
    { amount: 0.45 },
  );
</script>

<style>
  .explorer {
    font-size: 13px;
  }
  .panel-bar {
    gap: 16px;
  }
  .cmdline {
    color: var(--term-fg);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }
  .target {
    color: var(--term-mod);
  }
  .pick {
    margin-left: auto;
  }
  .touring {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
    color: var(--term-dim);
    font-size: 12px;
    white-space: nowrap;
  }
  .touring + .pick {
    margin-left: 0;
  }
  .pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--term-add);
    animation: pulse 1.6s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.25;
      transform: scale(0.7);
    }
  }
  @media (max-width: 640px) {
    .touring {
      display: none;
    }
  }
  select {
    font: inherit;
    color: var(--term-fg);
    background: var(--term);
    border: 1px solid var(--term-line);
    border-radius: 8px;
    padding: 6px 28px 6px 10px;
    max-width: 260px;
  }
  select:focus-visible {
    outline: 2px solid var(--term-add);
    outline-offset: 2px;
  }
  .stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 420px);
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    padding: 18px 8px 18px 18px;
    overflow: visible;
  }
  .edges,
  .lit {
    pointer-events: none; /* lines pass under labels; clicks belong to the files */
  }
  .edges path {
    fill: none;
    stroke: rgba(214, 238, 222, 0.1);
    stroke-width: 1.2;
  }
  .lit path {
    fill: none;
    stroke: var(--term-add);
    stroke-width: 2;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
    filter: drop-shadow(0 0 4px rgba(95, 214, 141, 0.55));
  }
  .node {
    cursor: pointer;
    outline: none;
  }
  .node.test {
    cursor: default;
  }
  .dot {
    fill: var(--term-2);
    stroke: var(--term-dim);
    stroke-width: 1.5;
    transition:
      fill 0.3s var(--ease) var(--d, 0s),
      stroke 0.3s var(--ease) var(--d, 0s);
  }
  .ring {
    fill: none;
    stroke: var(--term-mod);
    stroke-width: 1.5;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .node text {
    font: 400 11px var(--mono);
    fill: var(--term-dim);
    transition: fill 0.3s var(--ease) var(--d, 0s);
  }
  .test .dot {
    stroke-dasharray: 2 2;
  }
  .node:not(.test):hover text,
  .node:focus-visible text {
    fill: var(--term-fg);
  }
  .node:focus-visible .dot {
    stroke: var(--term-fg);
    stroke-width: 2.5;
  }
  .active .node:not(.changed):not(.reached) .dot {
    stroke: rgba(214, 238, 222, 0.22);
  }
  .active .node:not(.changed):not(.reached) text {
    fill: rgba(214, 238, 222, 0.32);
  }
  .changed .dot {
    fill: var(--term-mod);
    stroke: var(--term-mod);
  }
  .changed text {
    fill: var(--term-mod);
  }
  .reached .dot {
    fill: var(--term-add);
    stroke: var(--term-add);
  }
  .reached text {
    fill: var(--term-fg);
  }
  .reached.test .dot {
    fill: var(--term-dir);
    stroke: var(--term-dir);
    stroke-dasharray: none;
  }
  .helper .dot {
    stroke-dasharray: 1.5 2;
  }
  .reached.helper .dot {
    fill: rgba(134, 200, 255, 0.35);
    stroke: var(--term-dir);
    stroke-dasharray: 1.5 2;
  }
  .reached.helper text {
    fill: rgba(134, 200, 255, 0.75);
  }
  .reached.test text {
    fill: var(--term-dir);
  }
  .readout {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    border-left: 1px solid var(--term-line);
    min-height: 0;
  }
  .counts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0;
    border-bottom: 1px solid var(--term-line);
  }
  .counts div {
    padding: 18px 20px 16px;
  }
  .counts div + div {
    border-left: 1px solid var(--term-line);
  }
  .counts dt {
    font: 400 12px var(--mono);
    color: var(--term-dim);
  }
  .counts dd {
    margin: 8px 0 0;
    font: 650 clamp(34px, 3.6vw, 48px) / 1 var(--display);
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--term-add);
  }
  .counts div + div dd {
    color: var(--term-dir);
  }
  .out {
    margin: 0;
    padding: 16px 20px 20px;
    font: 400 11.5px/1.6 var(--mono);
    color: var(--term-fg);
    white-space: pre;
    overflow: auto;
    max-height: 430px;
    scrollbar-width: thin;
  }
  .out:focus-visible {
    outline: 2px solid var(--term-add);
    outline-offset: -2px;
  }
  .note {
    margin: 18px 0 0;
    font-size: 14px;
    line-height: 1.6;
    max-width: 62em;
  }
  .note a {
    color: inherit;
    text-underline-offset: 3px;
  }
  .note .more {
    color: var(--leaf-ink);
    font-weight: 500;
    margin-left: 6px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  @media (max-width: 960px) {
    .stage {
      grid-template-columns: minmax(0, 1fr);
    }
    .readout {
      border-left: 0;
      border-top: 1px solid var(--term-line);
    }
    .out {
      max-height: 300px;
    }
  }
  @media (max-width: 640px) {
    .node text {
      display: none;
    }
    .changed text,
    .node:focus-visible text {
      display: inline;
      font-size: 22px;
    }
    .cmdline {
      display: none;
    }
    .pick {
      margin-left: 0;
      width: 100%;
    }
    select {
      max-width: none;
      width: 100%;
    }
  }
</style>
