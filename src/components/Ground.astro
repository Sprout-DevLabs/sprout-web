---
// The logo grows out of its ground line as you scroll: leaves up, roots down.
import Mark from '../assets/sprout-mark.svg';
---

<section class="ground" id="ground">
  <div class="stick">
    <div class="wrap scene">
      <p class="above"><span>Above ground</span>The files you can see.</p>
      <div class="mark"><Mark aria-hidden="true" /></div>
      <p class="below"><span>Below ground</span>How they connect. Sprout maps it.</p>
    </div>
  </div>
</section>

<style>
  .ground {
    border-top: 1px solid var(--line);
  }
  /* Only scroll-linked when motion runs; otherwise a plain, full-grown band. */
  :global(.moving) .ground {
    height: 220vh;
  }
  .stick {
    padding-block: var(--section);
  }
  :global(.moving) .stick {
    position: sticky;
    top: 0;
    height: 100vh;
    padding: 0;
    display: grid;
    align-items: center;
  }
  .scene {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: clamp(24px, 5vw, 72px);
  }
  .mark {
    color: var(--sage);
    /* the ground line sits 64% of the way down the mark */
    transform-origin: 50% 64%;
  }
  .mark :global(svg) {
    height: min(56vh, 520px);
    width: auto;
  }
  .above,
  .below {
    margin: 0;
    font: 640 clamp(24px, 3vw, 38px) / 1.1 var(--display);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .above {
    text-align: right;
    align-self: start;
    margin-top: 12vh;
  }
  .below {
    align-self: end;
    margin-bottom: 8vh;
    color: var(--leaf);
  }
  .above span,
  .below span {
    display: block;
    margin-bottom: 10px;
    font: 600 13px var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .scene {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      text-align: center;
    }
    .above,
    .below {
      text-align: center;
      margin: 0;
    }
    .mark :global(svg) {
      height: 40vh;
    }
  }
</style>

<script>
  import { animate, scroll } from 'motion';
  import { reducedMotion } from '../scripts/motion';

  const section = document.getElementById('ground');
  const mark = section?.querySelector<HTMLElement>('.mark');
  if (section && mark && !reducedMotion()) {
    const span = () => ({ target: section, offset: ['start start', 'end end'] as ['start start', 'end end'] });
    scroll(
      animate(mark, { clipPath: ['inset(62% 0 34% 0)', 'inset(0% 0 0% 0)'], scale: [0.55, 1] }, { ease: 'linear' }),
      span(),
    );
    section.querySelectorAll<HTMLElement>('.above, .below').forEach((p, i) =>
      scroll(animate(p, { opacity: [0, 0, 1], y: [i ? -24 : 24, i ? -24 : 24, 0] }, { ease: 'linear' }), span()),
    );
  }
</script>
