---
import CopyCommand from './CopyCommand.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tools = [
  { name: 'project_map', what: 'The map, key files and signatures.' },
  { name: 'reading_order', what: 'Where to start, and why.' },
  { name: 'impact', what: 'What could break, and the tests to run.' },
  { name: 'context', what: 'What a file uses, its users and tests.' },
  { name: 'deps · dependents', what: 'What a file uses, and what uses it.' },
  { name: 'tree · diff_tree', what: 'A folder, or a branch diff, as a tree.' },
];
---

<section class="section" id="agents">
  <div class="wrap split">
    <div class="section-head">
      <p class="eyebrow">02 / MCP</p>
      <h2>One line. <span class="dim">Your agent stops guessing.</span></h2>
      <p class="lead">An MCP server for Claude Code, Cursor, VS Code and Claude Desktop. Read-only, and always current.</p>
      <div class="setup">
        <CopyCommand command="claude mcp add sprout -- sprout mcp" />
        <CopyCommand command="sprout mcp --print-config cursor" />
      </div>
      <p class="muted small">
        <a href={`${base}/docs/guides/mcp/`}>Setup and safety →</a>
      </p>
    </div>
    <ul class="tools" data-cascade>
      {
        tools.map((t) => (
          <li data-spot>
            <code>{t.name}</code>
            <span class="muted">{t.what}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .section-head {
    margin: 0;
    grid-template-columns: minmax(0, 1fr);
  }
  .setup {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
    justify-items: start;
  }
  .small {
    font-size: 14px;
    margin: 0;
  }
  .small a {
    color: var(--ink-2);
  }
  .tools {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    align-self: center;
  }
  .tools li {
    display: grid;
    gap: 6px;
    padding: 18px;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: var(--surface);
    font-size: 14px;
    line-height: 1.5;
  }
  .tools code {
    width: fit-content;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font-size: 14px;
    font-weight: 600;
  }
  @media (max-width: 560px) {
    .tools {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
