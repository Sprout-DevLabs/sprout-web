---
import demo from '../data/demo.json';

// Parse the real `sprout --entry` output into steps.
const steps = demo.entry
  .split('\n')
  .map((l) => l.match(/^\s*(\d+)\.\s+(\S+)\s+(.*)$/))
  .filter((m): m is RegExpMatchArray => m !== null)
  .map(([, n, file, why]) => ({ n, file, why, used: Number(why.match(/used by (\d+)/)?.[1] ?? 0) }));
const most = Math.max(1, ...steps.map((s) => s.used));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="section" id="entry">
  <div class="wrap split">
    <div class="copy">
      <h2>Know where to start reading</h2>
      <p class="lead">
        <code>sprout --entry</code> gives a new teammate a reading order: what the project is, where execution starts,
        then the files the rest of the code depends on most.
      </p>
      <p class="muted">
        The ranking comes from real imports and references in Go, TypeScript, JavaScript, Python, Rust, Java and Kotlin.
        Tests don't vote. It works on repositories you haven't cloned, too.
      </p>
      <div class="remote">
        <span class="muted">Try it on any repo</span>
        <code>sprout github.com/owner/repo --entry</code>
      </div>
      <p class="muted">
        New to a project? <code>sprout tour</code> wraps the same list with the README's pitch, the layout and what to run
        next.
      </p>
      <div class="links">
        <a class="more" href={`${base}/docs/guides/entry/`}>How the ranking works</a>
        <a class="more" href={`${base}/docs/guides/tour/`}>Take the tour</a>
      </div>
    </div>

    <div class="panel">
      <div class="panel-bar"><span class="cmdline">sprout --entry</span><span class="right">Reading order for trailhead</span></div>
      <ol class="steps">
        {
          steps.map((s) => (
            <li style={`--w:${s.used / most}`}>
              <span class="n">{s.n}</span>
              <span class="f">{s.file}</span>
              <span class="why">{s.why}</span>
              <span class="bar" aria-hidden="true" />
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  import { animate, inView, stagger } from 'motion';
  import { reducedMotion } from '../scripts/stage';

  const list = document.querySelector<HTMLElement>('#entry .steps')!;
  if (!reducedMotion()) {
    const ease = [0.22, 1, 0.36, 1] as const;
    const items = list.querySelectorAll('li');
    const bars = list.querySelectorAll<HTMLElement>('.bar');
    animate(items, { opacity: 0, x: -10 }, { duration: 0 });
    animate(bars, { scaleX: 0 }, { duration: 0 });
    inView(
      list,
      () => {
        animate(items, { opacity: 1, x: 0 }, { duration: 0.6, ease, delay: stagger(0.04) });
        bars.forEach((b, i) =>
          animate(b, { scaleX: Number(getComputedStyle(b.parentElement!).getPropertyValue('--w')) || 0 }, {
            duration: 1,
            ease,
            delay: 0.25 + i * 0.04,
          }),
        );
      },
      { amount: 0.3 },
    );
  }
</script>

<style>
  .copy {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 22px;
    align-content: start;
  }
  .copy p {
    margin: 0;
  }
  .remote {
    display: grid;
    gap: 8px;
    font-size: 14px;
  }
  .remote code {
    width: fit-content;
    font-size: 14px;
    padding: 8px 12px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
  .more {
    width: fit-content;
    color: var(--leaf-ink);
    font-weight: 500;
    text-underline-offset: 4px;
  }
  .right {
    margin-left: auto;
  }
  .cmdline {
    color: var(--term-fg);
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 10px 22px 22px;
  }
  .steps li {
    display: grid;
    grid-template-columns: 2.2em minmax(0, 1fr) auto;
    column-gap: 14px;
    row-gap: 8px;
    align-items: baseline;
    padding: 12px 0;
    border-top: 1px solid var(--term-line);
  }
  .steps li:first-child {
    border-top: 0;
  }
  .n {
    color: var(--term-dim);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .f {
    color: var(--term-fg);
    overflow-wrap: anywhere;
    line-height: 1.4;
  }
  .why {
    color: var(--term-dim);
    font: 13px var(--sans);
    white-space: nowrap;
  }
  .bar {
    grid-column: 2 / -1;
    height: 3px;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--term-add), #9be7b8);
    transform: scaleX(var(--w));
    transform-origin: left;
  }
  @media (max-width: 640px) {
    .steps {
      padding: 6px 14px 16px;
    }
    .steps li {
      grid-template-columns: 1.8em minmax(0, 1fr);
    }
    .why {
      grid-column: 2;
      white-space: normal;
    }
    .right {
      display: none;
    }
  }
</style>
