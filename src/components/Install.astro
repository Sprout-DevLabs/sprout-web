---
import CopyCommand from './CopyCommand.astro';
import StarButton from './StarButton.astro';
import Mark from '../assets/sprout-mark.svg';
---

<section class="install" id="install">
  <div class="wrap">
    <div class="band">
      <Mark class="bg-mark" aria-hidden="true" />
      <h2>Plant it in your next repo.</h2>
      <p class="sub">macOS, Linux and Windows. MIT licensed.</p>
      <div class="cmds">
        <CopyCommand command="brew install sprout-devlabs/tap/sprout" />
        <CopyCommand command="scoop bucket add sprout https://github.com/Sprout-DevLabs/scoop-bucket; scoop install sprout" label="Copy: install with Scoop" />
        <CopyCommand command="go install github.com/Sprout-DevLabs/sprout@latest" />
      </div>
      <div class="ask"><StarButton /></div>
    </div>
  </div>
</section>

<style>
  .install {
    padding: var(--section) 0;
    border-top: 1px solid var(--line);
  }
  .band {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    text-align: center;
    padding: clamp(48px, 8vw, 96px) clamp(16px, 4vw, 48px);
    border-radius: 28px;
    border: 1px solid var(--line);
    background:
      radial-gradient(60% 80% at 50% 0%, rgba(255, 255, 255, 0.07), transparent 70%),
      var(--bg-2);
  }
  .bg-mark {
    position: absolute;
    left: 50%;
    bottom: -120px;
    height: 360px;
    width: auto;
    translate: -50% 0;
    color: var(--ink);
    opacity: 0.035;
    pointer-events: none;
  }
  h2,
  .sub,
  .cmds,
  .ask {
    position: relative;
  }
  .sub {
    margin: 14px 0 0;
    color: var(--muted);
  }
  .cmds {
    display: grid;
    gap: 10px;
    margin-top: 36px;
    width: min(100%, 640px);
  }
  .cmds :global(.cmd) {
    width: 100%;
    min-width: 0;
  }
  .cmds :global(.cmd .txt) {
    flex: 1;
  }
  .cmds :global(.cmd) {
    background: var(--bg);
    border-color: var(--line);
    box-shadow: none;
  }
  .ask {
    margin-top: 28px;
  }
</style>
