---
import CopyCommand from './CopyCommand.astro';
import StarButton from './StarButton.astro';
import Mark from '../assets/sprout-mark.svg';
---

<section class="install" id="install">
  <div class="wrap">
    <div class="band">
      <Mark class="bg-mark" aria-hidden="true" />
      <h2>Plant it in your next repo.</h2>
      <div class="cmds">
        <CopyCommand command="brew install sprout-devlabs/tap/sprout" />
        <CopyCommand command="scoop bucket add sprout https://github.com/Sprout-DevLabs/scoop-bucket; scoop install sprout" label="Copy: install with Scoop" />
        <CopyCommand command="go install github.com/Sprout-DevLabs/sprout@latest" />
      </div>
      <div class="ask">
        <span>If Sprout saves you or your agent some digging, a star helps others find it.</span>
        <StarButton />
      </div>
    </div>
  </div>
</section>

<style>
  .install {
    padding-bottom: var(--section);
  }
  .band {
    position: relative;
    overflow: hidden;
    padding: clamp(36px, 6vw, 64px);
    border-radius: 24px;
    border: 1px solid rgba(79, 207, 130, 0.22);
    background:
      radial-gradient(70% 120% at 88% 110%, rgba(79, 207, 130, 0.3), transparent 60%),
      radial-gradient(50% 80% at 0% 0%, rgba(198, 213, 190, 0.08), transparent 70%),
      linear-gradient(155deg, #1d2f22, #0f1913 70%);
    box-shadow: var(--shadow-panel);
    color: #eef4ea;
  }
  .bg-mark {
    position: absolute;
    right: 40px;
    bottom: -70px;
    height: 340px;
    width: auto;
    color: var(--sage);
    opacity: 0.16;
    filter: drop-shadow(0 0 40px rgba(79, 207, 130, 0.5));
    pointer-events: none;
  }
  h2 {
    position: relative;
    color: #eef4ea;
    max-width: 14em;
  }
  .cmds {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: start;
    gap: 10px;
    margin-top: 32px;
  }
  .cmds :global(.cmd) {
    background: var(--bg);
    border-color: transparent;
  }
  .ask {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 32px;
    color: var(--sage);
    font-size: 15px;
  }
</style>
