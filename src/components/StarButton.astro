---
// "Star on GitHub", with the count once it's worth showing. ui.ts refreshes
// the count in the browser, so it doesn't wait for the next build.
import { REPO, STAR_THRESHOLD, stars, formatStars } from '../lib/github';

interface Props { size?: 'sm' | 'md'; label?: string }
const { size = 'md', label = 'Star on GitHub' } = Astro.props;
const n = await stars();
const show = n !== null && n >= STAR_THRESHOLD;
---
<a
  class:list={['star-btn', `star-${size}`]}
  href={`https://github.com/${REPO}`}
  data-star-threshold={STAR_THRESHOLD}
  aria-label={show ? `${label}: ${n} stars` : label}
>
  <svg class="gh" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.39-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
  <span class="star-label">{size === 'sm' ? 'Star' : label}</span>
  <span class="star-count" data-star-count hidden={!show}>
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2.6 2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.5l-5.9 3.1 1.2-6.5L2.5 9.5l6.6-.9z"/></svg>
    <span data-star-n>{show ? formatStars(n!) : ''}</span>
  </span>
</a>

<style is:global>
/* "Star on GitHub", with the count once there's a count worth showing */
.star-btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  height: 52px;
  padding: 0 18px;
  border-radius: 14px;
  border: 1px solid var(--line-2, var(--sl-color-gray-5));
  background: var(--surface, var(--sl-color-bg-nav));
  color: var(--ink, var(--sl-color-white));
  font: 600 15px var(--sans, var(--sl-font));
  text-decoration: none;
  white-space: nowrap;
  transition:
    transform 0.2s var(--ease, ease),
    border-color 0.2s;
}
.star-btn:hover {
  border-color: var(--muted, var(--sl-color-gray-3));
}
.star-btn:active {
  transform: scale(0.97);
}
.star-btn .gh {
  width: 18px;
  height: 18px;
}
.star-btn .star-count {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding-left: 10px;
  border-left: 1px solid var(--line-2, var(--sl-color-gray-5));
  color: var(--ink-2, var(--sl-color-gray-2));
  font: 500 14px var(--mono, var(--sl-font-mono));
}
.star-btn .star-count[hidden] {
  display: none;
}
.star-btn .star-count svg {
  width: 14px;
  height: 14px;
  color: #e3b341;
}
.star-btn.star-sm {
  height: 34px;
  padding: 0 12px;
  gap: 7px;
  border-radius: 10px;
  font-size: 13.5px;
}
.star-btn.star-sm .gh {
  width: 16px;
  height: 16px;
}
.star-btn.star-sm .star-count {
  padding-left: 7px;
  font-size: 12.5px;
}
</style>
