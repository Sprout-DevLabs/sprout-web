---
// Kubernetes timing: median of the controlled run at 636d292 on the
// /benchmarks page. Accuracy: tools/accuracy in the sprout repo.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="section" id="proof">
  <div class="wrap">
    <p class="eyebrow">03 / Proof</p>
    <p class="statement">
      Maps all 31,412 files of Kubernetes in 0.23 s. <span class="dim">Finds 100% of in-repo imports on click, ky and
      fastapi-template, checked against each language's own tooling.</span> Seven languages, one binary.
    </p>
    <div class="links">
      <a class="arrow-link" href={`${base}/benchmarks/`}>Benchmark log</a>
      <a class="arrow-link" href="https://github.com/Sprout-DevLabs/sprout/tree/main/tools/accuracy">How accuracy is measured</a>
      <a class="arrow-link" href="https://github.com/Sprout-DevLabs/sprout">Read the source</a>
    </div>
  </div>
</section>

<style>
  .statement {
    margin: 20px 0 0;
    max-width: 22em;
    font: 600 clamp(28px, 3.8vw, 46px) / 1.15 var(--display);
    letter-spacing: -0.035em;
    text-wrap: pretty;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 32px;
    margin-top: 40px;
  }
</style>
