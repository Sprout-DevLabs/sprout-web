---
// Kubernetes timing: median of the controlled run at 636d292 on the
// /benchmarks page. Accuracy: tools/accuracy in the sprout repo.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const stats = [
  { n: '0.23', unit: ' s', what: 'to map Kubernetes, all 31,412 files, with a warm cache.', link: 'Benchmark log', href: `${base}/benchmarks/` },
  { n: '100%', unit: '', what: "of in-repo imports found on click, ky and fastapi-template, checked against each language's own tooling.", link: "How it's measured", href: 'https://github.com/Sprout-DevLabs/sprout/tree/main/tools/accuracy' },
  { n: '7', unit: ' languages', what: 'Go, TypeScript, JavaScript, Python, Rust, Java and Kotlin. One binary, Go standard library only, MIT licensed.', link: 'Read the source', href: 'https://github.com/Sprout-DevLabs/sprout' },
];
---

<section class="section" id="proof">
  <div class="wrap stats" data-cascade>
    {
      stats.map((s) => (
        <div class="stat">
          <div class="n"><span data-count>{s.n}</span><small>{s.unit}</small></div>
          <p>{s.what}</p>
          <a href={s.href}>{s.link}</a>
        </div>
      ))
    }
  </div>
</section>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .stat {
    padding: 28px;
    border-radius: 18px;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .n {
    font: 800 56px/1 var(--display);
    letter-spacing: -0.03em;
  }
  .n small {
    font-size: 26px;
  }
  .stat p {
    margin: 14px 0 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .stat a {
    display: inline-block;
    margin-top: 14px;
    font-size: 14px;
    color: var(--leaf-ink);
    text-underline-offset: 4px;
  }
  @media (max-width: 960px) {
    .stats {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
