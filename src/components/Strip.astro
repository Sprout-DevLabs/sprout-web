---
// A slow ribbon of what Sprout reads and who it works with.
const groups = [
  { label: 'Reads', items: ['Go', 'TypeScript', 'JavaScript', 'Python', 'Rust', 'Java', 'Kotlin'] },
  { label: 'Works with', items: ['Claude Code', 'Cursor', 'VS Code', 'Claude Desktop', 'any MCP client'] },
];
---

<section class="strip" aria-label="Languages Sprout reads and agents it works with">
  <div class="track">
    {
      [false, true].map((hidden) => (
        <ul class="run" aria-hidden={hidden ? 'true' : undefined}>
          {groups.map((g) => (
            <>
              <li class="label">{g.label}</li>
              {g.items.map((it) => (
                <li>{it}</li>
              ))}
              <li class="sep" aria-hidden="true">
                <svg viewBox="0 0 16 16"><path d="M8 0c.6 4.2 3.8 7.4 8 8-4.2.6-7.4 3.8-8 8-.6-4.2-3.8-7.4-8-8 4.2-.6 7.4-3.8 8-8Z" /></svg>
              </li>
            </>
          ))}
        </ul>
      ))
    }
  </div>
</section>

<style>
  .strip {
    border-block: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .track {
    display: flex;
    width: max-content;
    animation: drift 46s linear infinite;
  }
  .strip:hover .track {
    animation-play-state: paused;
  }
  .run {
    display: flex;
    align-items: center;
    gap: 34px;
    margin: 0;
    padding: 20px 17px;
    list-style: none;
    font: 600 clamp(17px, 1.8vw, 22px) var(--display);
    letter-spacing: -0.01em;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .label {
    font: 600 12px var(--sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--leaf);
  }
  .sep svg {
    width: 14px;
    height: 14px;
    fill: var(--sage);
    opacity: 0.5;
    display: block;
  }
  @keyframes drift {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
      flex-wrap: wrap;
      width: auto;
    }
    .run[aria-hidden] {
      display: none;
    }
    .run {
      flex-wrap: wrap;
      white-space: normal;
    }
  }
</style>
