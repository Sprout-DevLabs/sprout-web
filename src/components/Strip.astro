---
// What Sprout reads and who it works with, in one quiet line.
const groups = [
  { label: 'Reads', items: ['Go', 'TypeScript', 'JavaScript', 'Python', 'Rust', 'Java', 'Kotlin'] },
  { label: 'Works with', items: ['Claude Code', 'Cursor', 'VS Code', 'Claude Desktop'] },
];
---

<section class="strip" aria-label="Languages Sprout reads and the agents it works with, through any MCP client">
  <div class="track">
    {
      [false].map(() => (
        <ul class="run">
          {groups.map((g) => (
            <>
              <li class="label">{g.label}</li>
              {g.items.map((it) => (
                <li>{it}</li>
              ))}
              <li class="sep" aria-hidden="true">
                <svg viewBox="0 0 16 16"><path d="M8 0c.6 4.2 3.8 7.4 8 8-4.2.6-7.4 3.8-8 8-.6-4.2-3.8-7.4-8-8 4.2-.6 7.4-3.8 8-8Z" /></svg>
              </li>
            </>
          ))}
        </ul>
      ))
    }
  </div>
</section>

<style>
  .strip {
    border-block: 1px solid var(--line);
  }
  .run {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 10px 28px;
    max-width: calc(var(--wrap) + 2 * var(--gutter));
    margin: 0 auto;
    padding: 22px var(--gutter);
    list-style: none;
    font: 500 15px var(--sans);
    letter-spacing: -0.01em;
    color: var(--muted);
  }
  .label {
    font: 500 11px var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .sep {
    width: 1px;
    height: 14px;
    background: var(--line-2);
  }
  .sep svg,
  .run > .sep:last-child {
    display: none;
  }
</style>
