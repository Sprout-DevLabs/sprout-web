---
import Showcase from './home/Showcase.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="hero">
  <canvas class="silk" aria-hidden="true"></canvas>
  <div class="wrap hero-copy">
    <a class="news" href="https://github.com/Sprout-DevLabs/sprout/releases/latest">
      <span class="tag">New</span> Architecture rules in v0.6.0
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m6 4 4 4-4 4" /></svg>
    </a>
    <h1>Stop your agent<br /> grepping around.</h1>
    <p class="lead">One call gives your coding agent the map: where to start, what a change breaks, which tests to run.</p>
    <div class="actions">
      <a class="btn btn-solid" href={`${base}/docs/install/`}>Get Sprout</a>
      <a class="btn btn-dark" href={`${base}/docs/`}>Read the docs</a>
    </div>
  </div>
  <div class="wrap">
    <Showcase />
  </div>
</section>

<script>
  import { silk } from '../scripts/silk';
  import { reducedMotion } from '../scripts/motion';
  const canvas = document.querySelector<HTMLCanvasElement>('.hero .silk');
  if (canvas) silk(canvas, reducedMotion());
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding: clamp(56px, 9vw, 112px) 0 clamp(80px, 10vw, 140px);
  }
  .silk {
    position: absolute;
    inset: 0 0 auto;
    width: 100%;
    height: min(110svh, 1000px);
    z-index: -1;
    opacity: 0;
    transition: opacity 1.2s;
    -webkit-mask-image: linear-gradient(#000 45%, transparent 92%);
    mask-image: linear-gradient(#000 45%, transparent 92%);
  }
  .silk:global(.on) {
    opacity: 1;
  }
  .hero-copy {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .news {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 4px 12px 4px 4px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: rgba(9, 9, 11, 0.5);
    backdrop-filter: blur(10px);
    color: var(--ink-2);
    font-size: 13.5px;
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .news:hover {
    border-color: rgba(255, 255, 255, 0.24);
  }
  .tag {
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--leaf);
    color: #03140a;
    font-weight: 600;
    font-size: 12px;
  }
  .news svg {
    width: 14px;
    height: 14px;
    color: var(--muted);
  }
  h1 {
    margin-top: 28px;
    font: 700 clamp(44px, 7vw, 84px) / 1 var(--display);
    letter-spacing: -0.05em;
  }
  .lead {
    margin: 22px auto 0;
    max-width: 30em;
    font-size: clamp(17px, 1.6vw, 19px);
    color: var(--ink-2);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 32px;
  }
</style>
