---
import CopyCommand from './CopyCommand.astro';
import StarButton from './StarButton.astro';
import Term from './Term.astro';
import impact from '../data/impact.txt?raw';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// The first greps an agent runs to answer the same question on pallets/click
// (2247b35): each finds the modules importing the last hit. 42 calls in all.
const greps = ['core', 'types', 'utils', 'termui', 'core', '_termui_impl', '_compat', 'formatting', '_winconsole', '_textwrap', 'shell_completion', 'parser', 'globals'];
---

<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <a class="news" href="https://github.com/Sprout-DevLabs/sprout/releases/latest">
        <span class="dot" aria-hidden="true"></span> New in v0.4.2: tour any GitHub repo, no clone needed
      </a>
      <h1>Stop your coding agent grepping around. <span class="em">One call gives it the map.</span></h1>
      <p class="lead">
        Sprout maps how your project fits together: where to start reading, what a change could break and which tests to
        run. Your agent asks once over MCP. You get the same answers in your terminal.
      </p>
      <div class="actions">
        <CopyCommand command="brew install sprout-devlabs/tap/sprout" />
        <StarButton />
      </div>
      <div class="agent-line">
        <span class="muted">Then, in Claude Code:</span>
        <CopyCommand command="claude mcp add sprout -- sprout mcp" label="Copy: add Sprout to Claude Code" />
        <a href={`${base}/docs/guides/mcp/`}>Cursor, VS Code, Claude Desktop</a>
      </div>
      <p class="also muted">
        Also on <a href={`${base}/docs/install/#scoop`}>Scoop</a>,{' '}
        <a href={`${base}/docs/install/#linux-packages`}>apt, dnf and apk</a>,{' '}
        <a href={`${base}/docs/install/#install-script`}>curl | sh</a> and <a href={`${base}/docs/install/#go`}>go install</a>.
      </p>
    </div>

    <div class="panel race">
      <div class="race-q">
        <span>Which tests run after I change <code>src/click/core.py</code>?</span>
        <span class="repo">pallets/click</span>
      </div>
      <div class="lanes">
        <div class="lane">
          <div class="lane-name">grep, hit by hit</div>
          <div class="nums slow"><b data-count>42</b> calls <b data-count>5,992</b> tokens</div>
          <div class="greps" aria-hidden="true">
            <div class="greps-roll">
              {[0, 1].map(() => greps.map((g) => <div><span class="t-dim">$</span> grep -rnE "import .*\b{g}\b" .</div>))}
            </div>
          </div>
          <p class="note">One grep finds none of the tests: they import <code>click</code>, not <code>core</code>.</p>
        </div>
        <div class="lane win">
          <div class="lane-name">sprout impact</div>
          <div class="nums fast"><b>1</b> call <b data-count>225</b> tokens</div>
          <Term text={impact} max={15} class="out" />
          <p class="note">All 43 tests, and the command to run them.</p>
        </div>
      </div>
      <p class="race-foot">Measured with Sprout v0.4.2. Tokens are characters ÷ 4 on both sides.</p>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: clamp(56px, 8vw, 104px) 0 clamp(72px, 9vw, 128px);
    background: radial-gradient(60% 50% at 80% 30%, var(--glow), transparent 70%);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(40px, 5vw, 64px);
    align-items: center;
  }
  .news {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: var(--surface);
    color: var(--ink-2);
    font-size: 13.5px;
    text-decoration: none;
  }
  .news:hover {
    border-color: var(--muted);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--leaf);
    animation: pulse 1.6s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.35;
    }
  }
  h1 {
    margin: 28px 0 0;
    font: 800 clamp(42px, 5.6vw, 68px) / 0.98 var(--display);
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  h1 .em {
    display: block;
    margin-top: 8px;
    color: var(--leaf);
  }
  .lead {
    margin: 28px 0 0;
  }
  .actions,
  .agent-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .actions {
    margin-top: 36px;
  }
  .agent-line {
    margin-top: 20px;
    font-size: 14.5px;
  }
  .agent-line :global(.cmd) {
    height: 40px;
    font-size: 13px;
    padding-left: 14px;
  }
  .agent-line :global(.cmd .copy-ic) {
    width: 28px;
    height: 28px;
  }
  .agent-line a,
  .also a {
    color: var(--ink-2);
    text-decoration-color: var(--line-2);
    text-underline-offset: 4px;
  }
  .agent-line a:hover,
  .also a:hover {
    text-decoration-color: var(--leaf);
  }
  .also {
    margin: 14px 0 0;
    font-size: 14px;
  }

  .race {
    padding: 20px;
    font-family: var(--sans);
    line-height: 1.5;
  }
  .race-q {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 0 4px 16px;
    font-size: 13.5px;
  }
  .race code {
    background: none;
    border: 0;
    padding: 0;
    color: #fff;
  }
  .repo,
  .race-foot {
    color: var(--term-dim);
    font: 11.5px var(--mono);
  }
  .race-foot {
    margin: 16px 4px 0;
    font-family: var(--sans);
  }
  .lanes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .lane {
    min-width: 0;
    padding: 16px;
    border-radius: 12px;
    background: var(--term-2);
    border: 1px solid var(--term-line);
  }
  .lane.win {
    border-color: rgba(79, 207, 130, 0.28);
  }
  .lane-name {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .nums {
    margin-top: 6px;
    font-size: 12px;
    color: var(--muted);
  }
  .nums b {
    font: 600 30px var(--mono);
    margin-left: 10px;
  }
  .nums b:first-child {
    margin-left: 0;
  }
  .slow b {
    color: var(--term-mod);
  }
  .fast b {
    color: var(--term-add);
  }
  .greps,
  .lane :global(.out) {
    position: relative;
    height: 220px;
    margin-top: 12px;
    font: 11.5px/1.7 var(--mono);
    color: #b9cbb3;
    overflow: hidden;
  }
  .lane :global(.out) {
    font-size: 11px;
  }
  .greps div {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .greps-roll {
    animation: roll 16s linear infinite;
  }
  @keyframes roll {
    to {
      transform: translateY(-50%);
    }
  }
  .greps::after,
  .lane :global(.out)::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 56px;
    background: linear-gradient(transparent, var(--term-2));
  }
  .note {
    margin: 12px 0 0;
    font-size: 12.5px;
    color: var(--muted);
  }
  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .lanes {
      grid-template-columns: minmax(0, 1fr);
    }
    .greps,
    .lane :global(.out) {
      height: 150px;
    }
  }
</style>
