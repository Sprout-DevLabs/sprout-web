---
import CopyCommand from './CopyCommand.astro';
import StarButton from './StarButton.astro';
import Term from './Term.astro';
import impact from '../data/impact.txt?raw';
import Mark from '../assets/sprout-mark.svg';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const lines = ['Stop your coding agent grepping around.', 'One call gives it the map.'];
// The first greps an agent runs to answer the same question on pallets/click
// (2247b35): each finds the modules importing the last hit. 42 calls in all.
const greps = ['core', 'types', 'utils', 'termui', 'core', '_termui_impl', '_compat', 'formatting', '_winconsole', '_textwrap', 'shell_completion', 'parser', 'globals'];
---

<section class="hero">
  <canvas class="field" aria-hidden="true"></canvas>
  <div class="wrap hero-copy">
    <div class="seed" aria-hidden="true"><Mark /></div>
    <a class="news" href="https://github.com/Sprout-DevLabs/sprout/releases/latest">
      <span class="dot" aria-hidden="true"></span> New in v0.4.2: tour any GitHub repo, no clone needed
    </a>
    <h1 aria-label={lines.join(' ')}>
      {
        lines.map((line, l) => (
          <span class:list={['line', { em: l === 1 }]} aria-hidden="true">
            {line.split(' ').map((w, i) => (
              <>
                <span class="wm"><span class="wi" style={`--i:${i + l * 6}`}>{w}</span></span>{' '}
              </>
            ))}
          </span>
        ))
      }
    </h1>
    <p class="lead rise" style="--d:1.05s">
      Sprout maps how your project fits together: where to start reading, what a change could break and which tests to
      run. Your agent asks once over MCP. You get the same answers in your terminal.
    </p>
    <div class="actions rise" style="--d:1.2s">
      <CopyCommand command="brew install sprout-devlabs/tap/sprout" />
      <StarButton />
    </div>
    <div class="agent-line rise" style="--d:1.32s">
      <span class="muted">Then, in Claude Code:</span>
      <CopyCommand command="claude mcp add sprout -- sprout mcp" label="Copy: add Sprout to Claude Code" />
      <a href={`${base}/docs/guides/mcp/`}>Cursor, VS Code, Claude Desktop</a>
    </div>
    <p class="also muted rise" style="--d:1.4s">
      Also on <a href={`${base}/docs/install/#scoop`}>Scoop</a>,{' '}
      <a href={`${base}/docs/install/#linux-packages`}>apt, dnf and apk</a>,{' '}
      <a href={`${base}/docs/install/#install-script`}>curl | sh</a> and <a href={`${base}/docs/install/#go`}>go install</a>.
    </p>
  </div>

  <div class="wrap race-wrap rise" style="--d:1.5s">
    <div class="panel race">
      <div class="race-q">
        <span>Which tests run after I change <code>src/click/core.py</code>?</span>
        <span class="repo">pallets/click</span>
      </div>
      <div class="lanes">
        <div class="lane">
          <div class="lane-name">grep, hit by hit</div>
          <div class="nums slow"><b data-count>42</b> calls <b data-count>5,992</b> tokens</div>
          <div class="greps" aria-hidden="true">
            <div class="greps-roll">
              {[0, 1].map(() => greps.map((g) => <div><span class="t-dim">$</span> grep -rnE "import .*\b{g}\b" .</div>))}
            </div>
          </div>
          <p class="note">One grep finds none of the tests: they import <code>click</code>, not <code>core</code>.</p>
        </div>
        <div class="lane win">
          <div class="lane-name">sprout impact</div>
          <div class="nums fast"><b>1</b> call <b data-count>225</b> tokens</div>
          <Term text={impact} max={15} class="out" />
          <p class="note">All 43 tests, and the command to run them.</p>
        </div>
      </div>
      <p class="race-foot">Measured with Sprout v0.4.2. Tokens are characters ÷ 4 on both sides.</p>
    </div>
  </div>
</section>

<script>
  import { field } from '../scripts/field';
  import { reducedMotion } from '../scripts/motion';
  const canvas = document.querySelector<HTMLCanvasElement>('.hero .field');
  if (canvas) field(canvas, reducedMotion());
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    background: linear-gradient(var(--bg) min(62svh, 600px), transparent min(100svh, 980px));
    padding: clamp(40px, 6vw, 72px) 0 clamp(72px, 9vw, 128px);
  }
  /* the field fills the first screen; its centre is held back so the copy reads first */
  .field {
    position: absolute;
    inset: 0 0 auto;
    width: 100%;
    height: min(100svh, 980px);
    z-index: -1;
    -webkit-mask-image: radial-gradient(ellipse 62% 58% at 50% 38%, rgba(0, 0, 0, 0.22) 0%, rgba(0, 0, 0, 0.5) 45%, #000 80%),
      linear-gradient(#000 70%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: radial-gradient(ellipse 62% 58% at 50% 38%, rgba(0, 0, 0, 0.22) 0%, rgba(0, 0, 0, 0.5) 45%, #000 80%),
      linear-gradient(#000 70%, transparent);
    mask-composite: intersect;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 760px;
    z-index: -1;
    background: radial-gradient(42% 46% at 50% 16%, rgba(79, 207, 130, 0.16), transparent 70%);
    pointer-events: none;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .hero-copy > * {
    max-width: 100%;
  }
  .seed {
    color: var(--sage);
    margin-bottom: 20px;
    transform-origin: 50% 64%; /* its ground line */
    filter: drop-shadow(0 0 28px rgba(79, 207, 130, 0.35));
  }
  .seed :global(svg) {
    height: 60px;
    width: auto;
    display: block;
  }
  .news {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: color-mix(in srgb, var(--surface) 80%, transparent);
    backdrop-filter: blur(6px);
    color: var(--ink-2);
    font-size: 13.5px;
    text-decoration: none;
  }
  .news:hover {
    border-color: var(--muted);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--leaf);
    box-shadow: 0 0 0 0 rgba(79, 207, 130, 0.6);
    animation: ping 2s ease-out infinite;
  }
  @keyframes ping {
    70%,
    100% {
      box-shadow: 0 0 0 8px rgba(79, 207, 130, 0);
    }
  }
  h1 {
    margin: 26px 0 0;
    max-width: 15em;
    font: 800 clamp(40px, 6vw, 78px) / 0.96 var(--display);
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  h1 .line {
    display: block;
  }
  h1 .em {
    margin-top: 0.08em;
    color: var(--leaf);
    filter: drop-shadow(0 0 22px rgba(79, 207, 130, 0.28));
  }
  .lead {
    margin: 22px auto 0;
    max-width: 34em;
  }
  .actions,
  .agent-line {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px;
  }
  .actions {
    margin-top: 30px;
  }
  .actions > :global(*),
  .agent-line > :global(*) {
    min-width: 0;
    max-width: 100%;
  }
  .agent-line {
    margin-top: 20px;
    font-size: 14.5px;
  }
  .agent-line :global(.cmd) {
    height: 40px;
    font-size: 13px;
    padding-left: 14px;
  }
  .agent-line :global(.cmd .copy-ic) {
    width: 28px;
    height: 28px;
  }
  .agent-line a,
  .also a {
    color: var(--ink-2);
    text-decoration-color: var(--line-2);
    text-underline-offset: 4px;
  }
  .agent-line a:hover,
  .also a:hover {
    text-decoration-color: var(--leaf);
  }
  .also {
    margin: 14px 0 0;
    font-size: 14px;
  }
  .race-wrap {
    max-width: calc(1040px + 2 * var(--gutter));
    margin-top: clamp(56px, 8vw, 96px);
  }

  /* The opening: the logo sprouts from its ground line, the headline rises
     word by word, then everything else follows. Without JS or with reduced
     motion, it is all simply there. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .seed {
      animation: sprout 1s var(--ease) 0.1s both;
    }
    :global(.js) h1 .wi {
      animation: rise-word 0.9s var(--ease) both;
      animation-delay: calc(0.4s + var(--i) * 0.055s);
    }
    :global(.js) .news {
      animation: fade-up 0.7s var(--ease) 0.3s both;
    }
    :global(.js) .rise {
      animation: fade-up 0.9s var(--ease) var(--d) both;
    }
  }
  @keyframes sprout {
    from {
      clip-path: inset(62% 0 34% 0);
      transform: scale(0.7);
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    to {
      /* past the edges, so the glow isn't clipped once it has grown */
      clip-path: inset(-60% -60% -60% -60%);
      transform: none;
    }
  }
  @keyframes rise-word {
    from {
      transform: translateY(110%);
    }
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  .race {
    padding: 20px;
    font-family: var(--sans);
    line-height: 1.5;
  }
  .race-q {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 0 4px 16px;
    font-size: 13.5px;
  }
  .race code {
    background: none;
    border: 0;
    padding: 0;
    color: #fff;
  }
  .repo,
  .race-foot {
    color: var(--term-dim);
    font: 11.5px var(--mono);
  }
  .race-foot {
    margin: 16px 4px 0;
    font-family: var(--sans);
  }
  .lanes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .lane {
    min-width: 0;
    padding: 16px;
    border-radius: 12px;
    background: var(--term-2);
    border: 1px solid var(--term-line);
  }
  .lane.win {
    border-color: rgba(79, 207, 130, 0.28);
  }
  .lane-name {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .nums {
    margin-top: 6px;
    font-size: 12px;
    color: var(--muted);
  }
  .nums b {
    font: 600 30px var(--mono);
    margin-left: 10px;
  }
  .nums b:first-child {
    margin-left: 0;
  }
  .slow b {
    color: var(--term-mod);
  }
  .fast b {
    color: var(--term-add);
  }
  .greps,
  .lane :global(.out) {
    position: relative;
    height: 220px;
    margin-top: 12px;
    font: 11.5px/1.7 var(--mono);
    color: #b9cbb3;
    overflow: hidden;
  }
  .lane :global(.out) {
    font-size: 11px;
  }
  .greps div {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .greps-roll {
    animation: roll 16s linear infinite;
  }
  @keyframes roll {
    to {
      transform: translateY(-50%);
    }
  }
  .greps::after,
  .lane :global(.out)::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 56px;
    background: linear-gradient(transparent, var(--term-2));
  }
  .note {
    margin: 12px 0 0;
    font-size: 12.5px;
    color: var(--muted);
  }
  @media (max-width: 560px) {
    .lanes {
      grid-template-columns: minmax(0, 1fr);
    }
    .greps,
    .lane :global(.out) {
      height: 150px;
    }
  }
</style>
