---
// Real `sprout tour` output on pallets/click (2247b35), from Sprout v0.4.2, parsed at build time.
import raw from '../data/tour.txt?raw';

const lines = raw.split('\n');
const after = (prefix: string) => lines.find((l) => l.startsWith(prefix))?.slice(prefix.length).trim() ?? '';
const project = after('Tour of ');
const purpose = after('Purpose (README.md excerpt): ');
const files = raw.match(/(\d[\d,]*) files?\b/)?.[0] ?? '';
const manifest = after('Ecosystem: ').match(/\(([^;]+);/)?.[1] ?? '';
const language = after('Languages: ').split(',')[0];
const layout = lines
  .map((l) => l.match(/^  (\S+)\/ \((\d+) files?\)$/))
  .filter((m): m is RegExpMatchArray => m !== null)
  .map(([, dir, n]) => ({ dir, n: Number(n) }));
const layoutTotal = layout.reduce((sum, d) => sum + d.n, 0);
const steps = lines
  .map((l) => l.match(/^\s+(\d+)\. (\S+) — (.*)$/))
  .filter((m): m is RegExpMatchArray => m !== null)
  .map(([, n, file, why]) => ({ n, file, why, used: Number(why.match(/used by (\d+)/)?.[1] ?? 0) }));
const most = Math.max(1, ...steps.map((s) => s.used));
const omitted = lines.find((l) => /^\s+\+\d+ reading/.test(l))?.trim().match(/^\+(\d+)/)?.[1];
const next = lines.find((l) => l.startsWith('  sprout context '))?.trim();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="section" id="tour">
  <div class="wrap split">
    <div class="copy">
      <h2>Your first day, in one command</h2>
      <p class="lead">
        <code>sprout tour</code> tells a new teammate what the project is, how it's laid out, what to read first and why,
        and what to run next.
      </p>
      <p class="muted">
        The reading list comes from real imports in Go, TypeScript, JavaScript, Python, Rust, Java and Kotlin: the README,
        then entry points, then the files the rest of the code uses most. Tests don't vote. It's offline and read-only, and
        never runs the project's code.
      </p>
      <div class="remote">
        <span class="muted">Any GitHub repo, no clone needed</span>
        <code>sprout tour github.com/owner/repo</code>
      </div>
      <div class="links">
        <a class="more" href={`${base}/docs/guides/tour/`}>Take the tour</a>
        <a class="more" href={`${base}/docs/guides/entry/`}>How the ranking works</a>
      </div>
    </div>

    <div class="panel">
      <div class="panel-bar"><span class="cmdline">sprout tour</span><span class="right">Tour of {project}</span></div>
      <div class="body">
        <p class="purpose reveal"><span class="label">Purpose</span>{purpose}</p>
        <ul class="facts reveal" aria-label="Project facts">
          <li>{manifest}</li>
          <li>{language}</li>
          <li>{files}</li>
        </ul>

        <div class="layout reveal">
          <span class="label">Layout</span>
          <div class="segments" aria-hidden="true">
            {layout.map((d) => <span class="seg" style={`--share:${d.n / layoutTotal}`} />)}
          </div>
          <ul class="dirs">
            {
              layout.map((d) => (
                <li>
                  <span class="f">{d.dir}/</span> <span class="why">{d.n}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <span class="label">Start here</span>
        <ol class="steps">
          {
            steps.map((s) => (
              <li style={`--w:${s.used / most}`}>
                <span class="n">{s.n}</span>
                <span class="f">{s.file}</span>
                <span class="why">{s.why}</span>
                {s.used > 0 && <span class="bar" aria-hidden="true" />}
              </li>
            ))
          }
        </ol>
        {omitted && <p class="omitted">+{omitted} more with --limit</p>}

        {
          next && (
            <p class="next reveal">
              <span class="label">Next</span>
              <code>{next}</code>
            </p>
          )
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { animate, inView, stagger } from 'motion';
  import { reducedMotion } from '../scripts/stage';

  const panel = document.querySelector<HTMLElement>('#tour .panel')!;
  if (!reducedMotion()) {
    const ease = [0.22, 1, 0.36, 1] as const;
    const reveals = panel.querySelectorAll('.reveal');
    const segs = panel.querySelectorAll<HTMLElement>('.seg');
    const items = panel.querySelectorAll('.steps li');
    const bars = panel.querySelectorAll<HTMLElement>('.bar');
    animate(reveals, { opacity: 0, y: 8 }, { duration: 0 });
    animate(segs, { scaleX: 0 }, { duration: 0 });
    animate(items, { opacity: 0, x: -10 }, { duration: 0 });
    animate(bars, { scaleX: 0 }, { duration: 0 });
    inView(
      panel,
      () => {
        // Purpose and facts, then the layout fills in, then the reading list.
        animate(reveals, { opacity: 1, y: 0 }, { duration: 0.6, ease, delay: stagger(0.12) });
        animate(segs, { scaleX: 1 }, { duration: 0.9, ease, delay: stagger(0.08, { startDelay: 0.3 }) });
        animate(items, { opacity: 1, x: 0 }, { duration: 0.6, ease, delay: stagger(0.05, { startDelay: 0.5 }) });
        bars.forEach((b, i) =>
          animate(b, { scaleX: Number(getComputedStyle(b.parentElement!).getPropertyValue('--w')) || 0 }, {
            duration: 1,
            ease,
            delay: 0.75 + i * 0.05,
          }),
        );
      },
      { amount: 0.25 },
    );
  }
</script>

<style>
  .copy {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 22px;
    align-content: start;
  }
  .copy p {
    margin: 0;
  }
  .remote {
    display: grid;
    gap: 8px;
    font-size: 14px;
  }
  .remote code {
    width: fit-content;
    font-size: 14px;
    padding: 8px 12px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
  .more {
    width: fit-content;
    color: var(--leaf-ink);
    font-weight: 500;
    text-underline-offset: 4px;
  }
  .right {
    margin-left: auto;
  }
  .cmdline {
    color: var(--term-fg);
  }
  .body {
    display: grid;
    gap: 18px;
    padding: 20px 22px 22px;
  }
  .body p {
    margin: 0;
  }
  .label {
    display: block;
    margin-bottom: 6px;
    color: var(--term-dim);
    font: 600 11px var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .purpose {
    color: var(--term-fg);
    font: 15px/1.5 var(--sans);
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .facts li {
    padding: 4px 10px;
    border: 1px solid var(--term-line);
    border-radius: 999px;
    color: var(--term-fg);
    font: 12px var(--sans);
  }
  .segments {
    display: flex;
    gap: 3px;
    height: 8px;
  }
  .seg {
    flex: var(--share) 1 0;
    min-width: 6px;
    border-radius: 4px;
    background: linear-gradient(90deg, var(--term-add), #9be7b8);
    transform-origin: left;
  }
  .seg:nth-child(2n) {
    opacity: 0.6;
  }
  .dirs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
    font-size: 13px;
  }
  .steps {
    list-style: none;
    margin: -6px 0 0;
    padding: 0;
  }
  .steps li {
    display: grid;
    grid-template-columns: 1.6em minmax(0, 1fr) auto;
    column-gap: 14px;
    row-gap: 6px;
    align-items: baseline;
    padding: 9px 0;
    border-top: 1px solid var(--term-line);
  }
  .steps li:first-child {
    border-top: 0;
  }
  .n {
    color: var(--term-dim);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .f {
    color: var(--term-fg);
    overflow-wrap: anywhere;
    line-height: 1.4;
  }
  .why {
    color: var(--term-dim);
    font: 13px var(--sans);
    white-space: nowrap;
  }
  .bar {
    grid-column: 2 / -1;
    height: 3px;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--term-add), #9be7b8);
    transform: scaleX(var(--w));
    transform-origin: left;
  }
  .omitted {
    margin-top: -10px !important;
    color: var(--term-dim);
    font: 12px var(--sans);
  }
  .next code {
    display: block;
    width: fit-content;
    max-width: 100%;
    overflow-wrap: anywhere;
    color: var(--term-add);
  }
  @media (max-width: 640px) {
    .body {
      padding: 16px 14px;
    }
    .steps li {
      grid-template-columns: 1.4em minmax(0, 1fr);
    }
    .why {
      grid-column: 2;
      white-space: normal;
    }
    .right {
      display: none;
    }
  }
</style>
