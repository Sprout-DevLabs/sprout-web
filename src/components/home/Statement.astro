---
// Kubernetes timing: median of the controlled run at 636d292 on /benchmarks.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rows = [
  { label: 'Reads', items: ['Go', 'TypeScript', 'JavaScript', 'Python', 'Rust', 'Java', 'Kotlin'] },
  { label: 'Works with', items: ['Claude Code', 'Cursor', 'VS Code', 'Claude Desktop', 'any MCP client'] },
  { label: 'Runs on', items: ['macOS', 'Linux', 'Windows'] },
];
---

<section class="statement-sec">
  <div class="wrap">
    <p class="statement">
      Maps all <a href={`${base}/benchmarks/`}>31,412 files</a> of Kubernetes in 0.23 s. <span class="dim">From a weekend
      script to a monorepo, one binary and no account.</span>
    </p>
    <dl class="spec">
      {
        rows.map((r) => (
          <div class="row">
            <dt>{r.label}</dt>
            <dd>
              <ul>
                {r.items.map((it) => (
                  <li>{it}</li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .statement-sec {
    padding: clamp(64px, 8vw, 104px) 0 clamp(72px, 8vw, 112px);
  }
  .statement {
    margin: 0;
    max-width: 21em;
    font: 600 clamp(30px, 4.2vw, 52px) / 1.12 var(--display);
    letter-spacing: -0.04em;
    text-wrap: pretty;
  }
  .statement a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--leaf);
    text-decoration-thickness: 3px;
    text-underline-offset: 8px;
  }
  /* A spec sheet: label on the left, values on one ruled line each. */
  .spec {
    margin: clamp(48px, 6vw, 72px) 0 0;
    border-bottom: 1px solid var(--line);
  }
  .row {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 8px 24px;
    align-items: baseline;
    padding: 20px 0;
    border-top: 1px solid var(--line);
  }
  dt {
    color: var(--muted);
    font-size: 15px;
  }
  dd {
    margin: 0;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
    font: 550 clamp(17px, 1.6vw, 20px) var(--display);
    letter-spacing: -0.02em;
    color: var(--ink-2);
  }
  /* values part on a short slash, so a wrapped line never starts with one */
  li:not(:last-child)::after {
    content: '/';
    margin: 0 14px;
    color: #3f3f46;
    font-weight: 400;
  }
  @media (max-width: 760px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
