---
// Sprout's commands on pallets/click (2247b35), as one window you can click
// through. Every pane is real CLI output; nothing here is a separate app.
import Term from '../Term.astro';
import tree from '../../data/tree.txt?raw';
import tour from '../../data/tour.txt?raw';
import diff from '../../data/diff.txt?raw';
import impact from '../../data/impact.txt?raw';
import context from '../../data/context.txt?raw';
import check from '../../data/check.txt?raw';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const groups = [
  {
    label: 'Explore',
    items: [
      { id: 'map', name: 'Project map', cmd: 'sprout src/click', what: 'The tree, with .gitignore respected', out: tree, icon: 'M3 4h10M3 8h10M3 12h6' },
      { id: 'tour', name: 'Reading order', cmd: 'sprout tour', what: 'What the project is and what to read first', out: tour, icon: 'M4 3v10l4-3 4 3V3z' },
      { id: 'diff', name: 'What changed', cmd: 'sprout --diff HEAD~5 src', what: 'A branch or commit range, as a tree', out: diff, icon: 'M5 3v6a3 3 0 0 0 3 3h3M11 9v6M5 3a1.5 1.5 0 1 0 0 0' },
    ],
  },
  {
    label: 'Before a change',
    items: [
      { id: 'context', name: 'Context', cmd: 'sprout context src/click/decorators.py', what: 'What to know before editing a file', out: context, icon: 'M3 3h10v10H3zM6 6h4M6 9h4' },
      { id: 'impact', name: 'Impact', cmd: 'sprout impact src/click/core.py', what: 'Every file a change reaches, and the tests to run', out: impact, icon: 'M8 2v4M8 10v4M2 8h4M10 8h4' },
    ],
  },
  {
    label: 'In CI',
    items: [
      { id: 'check', name: 'Rules', cmd: 'sprout check', what: 'Imports that break .sproutrules', out: check, icon: 'M8 2 3 4v4c0 3 2 5 5 6 3-1 5-3 5-6V4zM6 8l1.5 1.5L10 7' },
    ],
  },
];
const all = groups.flatMap((g) => g.items);
const first = 'impact';
---

<div class="showcase">
  <div class="frame">
    <div class="window" data-tabs>
      <div class="titlebar">
        <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="title">sprout — pallets/click</span>
        <span class="kbd" aria-hidden="true">⌘K</span>
      </div>
      <div class="body">
        <nav class="side" role="tablist" aria-label="Sprout commands">
          <div class="search" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="7" cy="7" r="4.5" /><path d="m10.5 10.5 3 3" /></svg>
            Ask the map
          </div>
          {
            groups.map((g) => (
              <div class="group">
                <p>{g.label}</p>
                {g.items.map((it) => (
                  <button role="tab" type="button" id={`t-${it.id}`} aria-controls={`p-${it.id}`} aria-selected={it.id === first ? 'true' : 'false'}>
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={it.icon} /></svg>
                    {it.name}
                  </button>
                ))}
              </div>
            ))
          }
          <a class="side-foot" href={`${base}/docs/`}>All commands →</a>
        </nav>
        <div class="main">
          {
            all.map((it) => (
              <section class="pane" role="tabpanel" id={`p-${it.id}`} aria-labelledby={`t-${it.id}`} hidden={it.id !== first}>
                <header>
                  <div>
                    <h3>{it.name}</h3>
                    <p>{it.what}</p>
                  </div>
                  <span class="chip">pallets/click</span>
                </header>
                <div class="screen">
                  <div class="prompt-line"><span class="sigil">$</span> {it.cmd}</div>
                  <Term text={it.out} />
                </div>
              </section>
            ))
          }
        </div>
      </div>
    </div>
  </div>
  <nav class="dock" aria-label="Ways to use Sprout">
    <a href={`${base}/docs/guides/tree/`} data-tip="Terminal">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 3 3-3 3M12 15h6" /></svg>
      <span class="sr-only">Terminal</span>
    </a>
    <a href={`${base}/docs/guides/mcp/`} data-tip="MCP for agents">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 7V3M15 7V3M7 7h10v4a5 5 0 0 1-10 0zM12 16v5" /></svg>
      <span class="sr-only">MCP for agents</span>
    </a>
    <a href={`${base}/docs/guides/git/`} data-tip="Git and diffs">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="2.2" /><circle cx="6" cy="18" r="2.2" /><circle cx="18" cy="8" r="2.2" /><path d="M6 8.2v7.6M18 10.2c0 4-6 3-11 6" /></svg>
      <span class="sr-only">Git and diffs</span>
    </a>
    <a href={`${base}/docs/guides/check/`} data-tip="Rules in CI">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 5 6v5c0 4.5 3 8 7 10 4-2 7-5.5 7-10V6zM9 12l2 2 4-4" /></svg>
      <span class="sr-only">Rules in CI</span>
    </a>
  </nav>
</div>

<style>
  .showcase {
    position: relative;
    margin-top: clamp(56px, 8vw, 88px);
  }
  .frame {
    padding: 10px;
    border-radius: 28px;
    border: 1px solid var(--line-2);
    background: rgba(255, 255, 255, 0.025);
    backdrop-filter: blur(16px);
    box-shadow: 0 50px 140px -40px rgba(0, 0, 0, 0.95);
  }
  .window {
    overflow: hidden;
    border-radius: 18px;
    border: 1px solid var(--line);
    background: var(--term);
  }
  .titlebar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 42px;
    padding: 0 16px;
    border-bottom: 1px solid var(--line);
    background: var(--term-2);
    font: 12.5px var(--sans);
    color: var(--muted);
  }
  .lights {
    display: flex;
    gap: 7px;
  }
  .lights i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #2a2a2e;
  }
  .kbd {
    justify-self: end;
    padding: 2px 7px;
    border-radius: 6px;
    border: 1px solid var(--line-2);
    font: 11px var(--mono);
  }
  .body {
    display: grid;
    grid-template-columns: 228px minmax(0, 1fr);
    height: 520px;
  }
  .side {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 14px 12px;
    border-right: 1px solid var(--line);
  }
  .search {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 34px;
    padding: 0 10px;
    border-radius: 9px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.03);
    color: var(--term-dim);
    font-size: 13px;
  }
  .search svg {
    width: 14px;
    height: 14px;
  }
  .group {
    display: grid;
    gap: 2px;
  }
  .group p {
    margin: 0 0 6px 10px;
    font-size: 12px;
    color: var(--term-dim);
  }
  [role='tab'] {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 34px;
    padding: 0 10px;
    border: 0;
    border-radius: 9px;
    background: none;
    color: var(--ink-2);
    font: 500 14px var(--sans);
    text-align: left;
    cursor: pointer;
    transition:
      background-color 0.15s,
      color 0.15s;
  }
  [role='tab'] svg {
    width: 16px;
    height: 16px;
    color: var(--muted);
  }
  [role='tab']:hover {
    background: rgba(255, 255, 255, 0.04);
  }
  [role='tab'][aria-selected='true'] {
    background: rgba(255, 255, 255, 0.07);
    color: #fff;
  }
  [role='tab'][aria-selected='true'] svg {
    color: var(--leaf);
  }
  .side-foot {
    margin-top: auto;
    padding: 0 10px;
    color: var(--muted);
    font-size: 13px;
    text-decoration: none;
  }
  .side-foot:hover {
    color: var(--ink);
  }
  .main {
    min-width: 0;
    overflow: hidden;
  }
  .pane {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 24px 28px 0;
  }
  .pane[hidden] {
    display: none;
  }
  .pane header {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 16px;
  }
  .pane h3 {
    font-size: 19px;
  }
  .pane header p {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 14px;
  }
  .chip {
    flex: none;
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    color: var(--muted);
    font: 12px var(--mono);
  }
  .screen {
    flex: 1;
    min-height: 0;
    margin-top: 20px;
    padding: 18px 20px;
    border-radius: 14px 14px 0 0;
    border: 1px solid var(--line);
    border-bottom: 0;
    background: #08080a;
    overflow: auto;
    scrollbar-width: thin;
    -webkit-mask-image: linear-gradient(#000 82%, transparent);
    mask-image: linear-gradient(#000 82%, transparent);
  }
  .prompt-line {
    margin-bottom: 12px;
    font: 12.5px var(--mono);
    color: var(--term-fg);
  }
  .sigil {
    color: var(--term-add);
    margin-right: 6px;
  }
  .screen :global(.term) {
    font-size: 12px;
    overflow: visible;
  }

  .dock {
    position: absolute;
    left: 50%;
    bottom: -34px;
    translate: -50% 0;
    display: flex;
    gap: 10px;
    padding: 9px;
    border-radius: 20px;
    border: 1px solid var(--line-2);
    background: rgba(24, 24, 27, 0.72);
    backdrop-filter: blur(18px) saturate(1.4);
    box-shadow: 0 20px 50px -10px rgba(0, 0, 0, 0.8);
  }
  .dock a {
    position: relative;
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    border-radius: 13px;
    background: linear-gradient(180deg, #2a2a30, #17171b);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--ink);
    transition: transform 0.25s var(--ease);
  }
  .dock a:nth-child(2) {
    background: linear-gradient(180deg, #5ee09a, #23a560);
    color: #03140a;
  }
  .dock a:hover {
    transform: translateY(-6px) scale(1.08);
  }
  .dock svg {
    width: 24px;
    height: 24px;
  }
  .dock a::after {
    content: attr(data-tip);
    position: absolute;
    bottom: calc(100% + 12px);
    left: 50%;
    translate: -50% 4px;
    padding: 4px 9px;
    border-radius: 7px;
    background: var(--ink);
    color: #09090b;
    font: 500 12px var(--sans);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.15s,
      translate 0.2s var(--ease);
  }
  .dock a:hover::after,
  .dock a:focus-visible::after {
    opacity: 1;
    translate: -50% 0;
  }

  @media (max-width: 760px) {
    .body {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr);
      height: 560px;
    }
    .side {
      flex-direction: row;
      gap: 4px;
      padding: 10px;
      overflow-x: auto;
      border-right: 0;
      border-bottom: 1px solid var(--line);
      scrollbar-width: none;
    }
    .search,
    .group p,
    .side-foot {
      display: none;
    }
    .group {
      display: flex;
    }
    [role='tab'] {
      white-space: nowrap;
    }
    .pane {
      padding: 18px 14px 0;
    }
    .chip {
      display: none;
    }
    .screen :global(.term) {
      font-size: 11px;
    }
    .title {
      font-size: 11.5px;
    }
  }
</style>
