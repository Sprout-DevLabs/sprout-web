---
// One answer, two doors: what you read in the terminal and the JSON an agent
// gets for the same question. Both are real Sprout v0.6.0 output on click.
import CopyCommand from '../CopyCommand.astro';
import impact from '../../data/impact.txt?raw';
import json from '../../data/impact.json.txt?raw';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const numbered = (s: string, max = 24) => s.trimEnd().split('\n').slice(0, max);
const clients = [
  { name: 'Claude Code', cmd: 'claude mcp add sprout -- sprout mcp' },
  { name: 'Cursor', cmd: 'sprout mcp --print-config cursor' },
  { name: 'VS Code', cmd: 'sprout mcp --print-config vscode' },
  { name: 'Claude Desktop', cmd: 'sprout mcp --print-config claude-desktop' },
];
---

<section class="section" id="agents">
  <div class="wrap">
    <div class="head">
      <h2>Same answer. <span class="dim">For you and your agent.</span></h2>
    </div>
    <div class="split">
      <div class="col">
        <div class="code-card" data-tabs>
          <div class="tabbar" role="tablist" aria-label="Output format">
            <button role="tab" type="button" id="dt-cli" aria-controls="dp-cli" aria-selected="true">Terminal</button>
            <button role="tab" type="button" id="dt-json" aria-controls="dp-json" aria-selected="false">MCP · JSON</button>
          </div>
          <div class="file">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m4 6 2.5 2L4 10M8.5 10.5H12" /></svg>
            sprout impact src/click/core.py
          </div>
          {
            [
              { id: 'cli', text: impact },
              { id: 'json', text: json },
            ].map((p, i) => (
              <div class="lines" role="tabpanel" id={`dp-${p.id}`} aria-labelledby={`dt-${p.id}`} hidden={i > 0}>
                {numbered(p.text).map((l, n) => (
                  <div class="ln">
                    <span class="no">{n + 1}</span>
                    <span class:list={['tx', { k: p.id === 'json' && /^\s*"/.test(l) }]}>{l || ' '}</span>
                  </div>
                ))}
              </div>
            ))
          }
        </div>
        <h3>The CLI prints it for you</h3>
        <p>Plain text in your terminal, or <code>--json</code> for scripts. The MCP server hands your agent the same answer.</p>
      </div>
      <div class="col">
        <div class="setup">
          {
            clients.map((c, i) => (
              <div class="client">
                <span class="n">{i + 1}</span>
                <span class="name">{c.name}</span>
                <CopyCommand command={c.cmd} />
              </div>
            ))
          }
          <p class="note">
            Read-only. Paths stay inside the project, and every call reads the disk again.
          </p>
        </div>
        <h3>One line to connect</h3>
        <p>Any MCP client works. <a href={`${base}/docs/guides/mcp/`}>Setup and safety →</a></p>
      </div>
    </div>
  </div>
</section>

<style>
  .head {
    margin-bottom: clamp(36px, 5vw, 56px);
  }
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--line);
    border-radius: 24px;
    overflow: hidden;
  }
  .col {
    min-width: 0;
    padding: clamp(20px, 3.4vw, 40px);
  }
  .col + .col {
    border-left: 1px solid var(--line);
  }
  .col h3 {
    margin-top: 28px;
    font-size: 18px;
  }
  .col > p {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 15px;
    max-width: 30em;
  }
  .col > p a {
    color: var(--ink);
    text-decoration: none;
  }
  .code-card,
  .setup {
    height: 400px;
    border-radius: 16px;
    border: 1px solid var(--line);
    background: var(--term);
    overflow: hidden;
  }
  .tabbar {
    display: flex;
    gap: 4px;
    padding: 6px;
    border-bottom: 1px solid var(--line);
  }
  [role='tab'] {
    height: 30px;
    padding: 0 12px;
    border: 0;
    border-radius: 8px;
    background: none;
    color: var(--muted);
    font: 500 13px var(--sans);
    cursor: pointer;
  }
  [role='tab'][aria-selected='true'] {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }
  .file {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-bottom: 1px solid var(--line);
    font: 12.5px var(--mono);
    color: var(--ink-2);
  }
  .file svg {
    width: 15px;
    height: 15px;
    color: var(--leaf);
  }
  .lines {
    padding: 12px 0;
    font: 12px/1.75 var(--mono);
    color: var(--term-fg);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(#000 70%, transparent 96%);
    mask-image: linear-gradient(#000 70%, transparent 96%);
  }
  .ln {
    display: flex;
    white-space: pre;
  }
  .no {
    flex: none;
    width: 44px;
    padding-right: 14px;
    text-align: right;
    color: #3f3f46;
    user-select: none;
  }
  .tx.k {
    color: #c9d1d9;
  }
  .setup {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px;
  }
  .client {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    gap: 6px 10px;
    align-items: center;
  }
  .client .n {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1px solid var(--line-2);
    font: 11px var(--mono);
    color: var(--muted);
  }
  .client .name {
    font-size: 14px;
    font-weight: 500;
  }
  .client :global(.cmd) {
    grid-column: 2;
    width: 100%;
    height: 40px;
    padding-left: 14px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.03);
    border-color: var(--line);
    box-shadow: none;
    font-size: 12.5px;
  }
  .client :global(.cmd .txt) {
    flex: 1;
  }
  .client :global(.cmd .copy-ic) {
    width: 28px;
    height: 28px;
    background: rgba(255, 255, 255, 0.06);
  }
  .note {
    margin: auto 0 0;
    font-size: 13px;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
    }
    .col + .col {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .setup {
      height: auto;
    }
    .note {
      margin-top: 8px;
    }
  }
</style>
