---
import CopyCommand from '../CopyCommand.astro';
import Mark from '../../assets/sprout-mark.svg';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="cta-sec">
  <div class="wrap">
    <div class="cta">
      <canvas class="silk" aria-hidden="true"></canvas>
      <Mark class="bg-mark" aria-hidden="true" />
      <h2>Plant it in your next repo.</h2>
      <p>macOS, Linux and Windows. MIT licensed.</p>
      <div class="actions">
        <a class="btn btn-solid" href={`${base}/docs/install/`}>Get Sprout</a>
        <a class="btn btn-dark" href="https://github.com/Sprout-DevLabs/sprout">View on GitHub</a>
      </div>
      <div class="quick"><CopyCommand command="brew install sprout-devlabs/tap/sprout" /></div>
    </div>
  </div>
</section>

<script>
  import { silk } from '../../scripts/silk';
  import { reducedMotion } from '../../scripts/motion';
  const canvas = document.querySelector<HTMLCanvasElement>('.cta .silk');
  if (canvas) silk(canvas, reducedMotion());
</script>

<style>
  .cta-sec {
    padding: var(--section) 0;
  }
  .cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    text-align: center;
    padding: clamp(64px, 10vw, 128px) clamp(16px, 4vw, 48px);
    border-radius: 28px;
    border: 1px solid var(--line-2);
    background: #0b0f0c;
  }
  .silk {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    opacity: 0;
    transition: opacity 1.2s;
  }
  .silk:global(.on) {
    opacity: 0.85;
  }
  .cta :global(.bg-mark) {
    position: absolute;
    right: clamp(-40px, 3vw, 48px);
    bottom: -80px;
    z-index: -1;
    height: clamp(260px, 32vw, 400px);
    width: auto;
    color: var(--sage);
    opacity: 0.14;
    filter: drop-shadow(0 0 40px rgba(79, 207, 130, 0.5));
    pointer-events: none;
  }
  h2 {
    font-size: clamp(36px, 5.4vw, 64px);
    letter-spacing: -0.05em;
    font-weight: 700;
  }
  p {
    margin: 14px 0 0;
    color: var(--ink-2);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 30px;
  }
  .quick {
    margin-top: 18px;
    max-width: 100%;
  }
  .quick :global(.cmd) {
    height: 40px;
    max-width: 100%;
    padding-left: 14px;
    border-radius: 10px;
    background: rgba(9, 9, 11, 0.55);
    backdrop-filter: blur(8px);
    border-color: var(--line-2);
    box-shadow: none;
    font-size: 13px;
  }
  .quick :global(.cmd .copy-ic) {
    width: 28px;
    height: 28px;
  }
</style>
