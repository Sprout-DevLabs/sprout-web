{
  "phases": [
    {
      "id": "p1",
      "number": 1,
      "name": "Streaming JSON",
      "from": "Recursive JSON materialization: every node marshalled into a temporary buffer, then the whole document re-indented",
      "to": "One streaming writer that encodes each value once into a reused buffer; compact by default, --pretty opt-in",
      "commit": "f1525e6",
      "pr": 27,
      "results": [
        {
          "metric": "json-wall-llvm"
        },
        {
          "metric": "json-alloc-bytes-llvm"
        },
        {
          "metric": "json-rss-llvm"
        }
      ]
    },
    {
      "id": "p2",
      "number": 2,
      "name": "Compact tree",
      "from": "One heap allocation per node, plus a stored absolute path and a separate name string",
      "to": "One allocation per directory, names sharing their relative path's bytes, and filesystem paths rebuilt on demand",
      "commit": "58d2169",
      "pr": 29,
      "results": [
        {
          "metric": "tree-live-llvm"
        },
        {
          "metric": "tree-objects-per-node-llvm"
        }
      ]
    },
    {
      "id": "p3",
      "number": 3,
      "name": "Dependency graph",
      "from": "Per-file import maps, forward edges only, package-level Go resolution against the root module",
      "to": "Integer file IDs with forward and reverse adjacency, test relationships, file-level Go edges and every go.mod in the tree",
      "commit": "636d292",
      "pr": 30,
      "results": [
        {
          "metric": "graph-edges-k8s"
        },
        {
          "metric": "dependents-lookup"
        }
      ]
    }
  ],
