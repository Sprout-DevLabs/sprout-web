---
import '../styles/site.css';
import Logo from '../components/Logo.astro';
import StarButton from '../components/StarButton.astro';

interface Props { title?: string; description?: string }
const {
  title = 'Sprout: the map of your codebase',
  description = 'Sprout maps your codebase for you and your coding agent: where to start reading, what a change could break and which tests to run, in one call over MCP or one command in your terminal.',
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/icon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#fafbf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0f0c" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(`${base}/og.png`, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Sprout: stop your coding agent grepping around. One call gives it the map." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(`${base}/og.png`, Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..800&family=Geist:wght@400..700&family=Geist+Mono:wght@400..600&display=swap"
    />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <header class="nav" id="nav">
      <div class="wrap">
        <a class="brand" href={`${base}/`} aria-label="Sprout home"><Logo /> sprout</a>
        <a class="nav-link" href={`${base}/docs/`}>Docs</a>
        <a class="nav-link" href={`${base}/benchmarks/`}>Benchmarks</a>
        <a class="nav-link nav-hide-sm" href={`${base}/docs/guides/mcp/`}>For agents</a>
        <a class="nav-link nav-hide-sm" href="https://github.com/Sprout-DevLabs/sprout/releases">Releases</a>
        <StarButton size="sm" />
      </div>
      <span class="progress" aria-hidden="true"></span>
    </header>

    <main id="main"><slot /></main>

    <footer class="foot">
      <div class="wrap foot-grid">
        <div class="foot-brand">
          <a class="brand" href={`${base}/`}><Logo /> sprout</a>
          <p class="muted">The map of your codebase, for you and your AI agent. MIT licensed.</p>
          <p class="muted">If Sprout saves you or your agent some digging, a star helps others find it.</p>
          <StarButton />
        </div>
        <nav aria-label="Documentation">
          <p>Docs</p>
          <a href={`${base}/docs/`}>Introduction</a>
          <a href={`${base}/docs/install/`}>Install</a>
          <a href={`${base}/docs/guides/ai/`}>AI context</a>
          <a href={`${base}/docs/reference/flags/`}>All flags</a>
        </nav>
        <nav aria-label="Project">
          <p>Project</p>
          <a href="https://github.com/Sprout-DevLabs/sprout">GitHub</a>
          <a href="https://github.com/Sprout-DevLabs/sprout/releases">Releases</a>
          <a href={`${base}/benchmarks/`}>Benchmarks</a>
          <a href="https://github.com/Sprout-DevLabs/sprout/issues">Report an issue</a>
          <a href="https://github.com/Sprout-DevLabs/sprout/blob/main/CONTRIBUTING.md">Contribute</a>
        </nav>
        <nav aria-label="Install">
          <p>Install</p>
          <a href={`${base}/docs/install/#homebrew`}>Homebrew</a>
          <a href={`${base}/docs/install/#scoop`}>Scoop</a>
          <a href={`${base}/docs/install/#install-script`}>install.sh</a>
          <a href={`${base}/docs/install/#linux-packages`}>Linux packages</a>
        </nav>
      </div>
    </footer>

    <script>
      import { initCopy, initNav, initStars } from '../scripts/ui.ts';
      import { setupMotion } from '../scripts/motion.ts';
      initNav();
      initCopy();
      initStars();
      setupMotion();
    </script>
    <style>
      .foot {
        border-top: 1px solid var(--line);
        padding: 72px 0 88px;
        font-size: 15px;
      }
      .foot-grid {
        display: grid;
        grid-template-columns: 2fr repeat(3, 1fr);
        gap: 40px;
      }
      .foot-brand p {
        margin: 16px 0 0;
        max-width: 26em;
      }
      .foot nav {
        display: grid;
        gap: 10px;
        align-content: start;
      }
      .foot nav p {
        margin: 0 0 4px;
        font-weight: 600;
        color: var(--ink);
      }
      .foot nav a {
        color: var(--muted);
        text-decoration: none;
        width: fit-content;
      }
      .foot nav a:hover {
        color: var(--ink);
      }
      @media (max-width: 760px) {
        .foot-grid {
          grid-template-columns: 1fr 1fr;
        }
        .foot-brand {
          grid-column: 1 / -1;
        }
      }
    </style>
  </body>
</html>
