---
import '../styles/site.css';
import Logo from '../components/Logo.astro';

interface Props { title?: string; description?: string }
const {
  title = 'Sprout: the map of your codebase',
  description = 'Sprout is a tree command that understands projects. It respects .gitignore, marks changes and hotspots in place, shows pull requests as trees, suggests where to start reading, and gives AI agents a compact map with real signatures.',
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/icon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#fafbf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0f0c" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..800&family=Geist:wght@400..700&family=Geist+Mono:wght@400..600&display=swap"
    />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <header class="nav" id="nav">
      <div class="wrap">
        <a class="brand" href={`${base}/`} aria-label="Sprout home"><Logo /> sprout</a>
        <a class="nav-link" href={`${base}/docs/`}>Docs</a>
        <a class="nav-link" href={`${base}/benchmarks/`}>Benchmarks</a>
        <a class="nav-link nav-hide-sm" href={`${base}/docs/guides/mcp/`}>For agents</a>
        <a class="nav-link nav-hide-sm" href="https://github.com/Sprout-DevLabs/sprout/releases">Releases</a>
        <a class="nav-link" href="https://github.com/Sprout-DevLabs/sprout" aria-label="Sprout on GitHub">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.39-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
        </a>
      </div>
      <span class="progress" aria-hidden="true"></span>
    </header>

    <main id="main"><slot /></main>

    <footer class="foot">
      <div class="wrap foot-grid">
        <div class="foot-brand">
          <a class="brand" href={`${base}/`}><Logo /> sprout</a>
          <p class="muted">The map of your codebase, for you and your AI agent. MIT licensed.</p>
        </div>
        <nav aria-label="Documentation">
          <p>Docs</p>
          <a href={`${base}/docs/`}>Introduction</a>
          <a href={`${base}/docs/install/`}>Install</a>
          <a href={`${base}/docs/guides/ai/`}>AI context</a>
          <a href={`${base}/docs/reference/flags/`}>All flags</a>
        </nav>
        <nav aria-label="Project">
          <p>Project</p>
          <a href="https://github.com/Sprout-DevLabs/sprout">GitHub</a>
          <a href="https://github.com/Sprout-DevLabs/sprout/releases">Releases</a>
          <a href={`${base}/benchmarks/`}>Benchmarks</a>
          <a href="https://github.com/Sprout-DevLabs/sprout/issues">Report an issue</a>
          <a href="https://github.com/Sprout-DevLabs/sprout/blob/main/CONTRIBUTING.md">Contribute</a>
        </nav>
        <nav aria-label="Install">
          <p>Install</p>
          <a href={`${base}/docs/install/#homebrew`}>Homebrew</a>
          <a href={`${base}/docs/install/#scoop`}>Scoop</a>
          <a href={`${base}/docs/install/#install-script`}>install.sh</a>
          <a href={`${base}/docs/install/#linux-packages`}>Linux packages</a>
        </nav>
      </div>
    </footer>

    <script>
      import { initCopy, initNav } from '../scripts/ui.ts';
      import { setupMotion } from '../scripts/motion.ts';
      initNav();
      initCopy();
      setupMotion();
    </script>
    <style>
      .foot {
        border-top: 1px solid var(--line);
        padding: 72px 0 88px;
        font-size: 15px;
      }
      .foot-grid {
        display: grid;
        grid-template-columns: 2fr repeat(3, 1fr);
        gap: 40px;
      }
      .foot-brand p {
        margin: 16px 0 0;
        max-width: 26em;
      }
      .foot nav {
        display: grid;
        gap: 10px;
        align-content: start;
      }
      .foot nav p {
        margin: 0 0 4px;
        font-weight: 600;
        color: var(--ink);
      }
      .foot nav a {
        color: var(--muted);
        text-decoration: none;
        width: fit-content;
      }
      .foot nav a:hover {
        color: var(--ink);
      }
      @media (max-width: 760px) {
        .foot-grid {
          grid-template-columns: 1fr 1fr;
        }
        .foot-brand {
          grid-column: 1 / -1;
        }
      }
    </style>
  </body>
</html>
